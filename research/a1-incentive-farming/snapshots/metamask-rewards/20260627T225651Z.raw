details\":{\"size\":119313,\"image\":{\"width\":86,\"height\":86}},\"fileName\":\"qr-rewards.svg\",\"contentType\":\"image/svg+xml\"}},\"isLarge\":false,\"dataTestId\":\"not-generated\"},\"dataTestId\":\"not-generated\"}],\"colorPalette\":{\"__typename\":\"colorPalettes\",\"sys\":{\"id\":\"7tNuovTj2hFDbW2xHRAaAI\",\"createdAt\":\"2024-06-07T13:36:07.967Z\",\"updatedAt\":\"2026-01-23T04:00:11.052Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"colorPalettes\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"internalName\":\"COMPLEMENTARY_GREEN_DARK_PURPLE_LIGHT\",\"themeAudience\":\"Complementary\",\"complementaryColor\":\"Green dark / Purple light\"},\"extraData\":{\"hasFox\":true,\"hasQRCode\":true,\"titleSize\":\"regular\",\"hasLargeButton\":true,\"isSkewingEnabled\":true}},{\"__typename\":\"moduleContainer\",\"sys\":{\"id\":\"4AJbO4D7QDxpKflLbCPbVl\",\"createdAt\":\"2025-10-20T16:34:17.360Z\",\"updatedAt\":\"2026-03-17T18:17:07.963Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleContainer\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"internalName\":\"Rewards \u003e FAQs\",\"component\":\"faq-block\",\"title\":\"Frequently Asked Questions\",\"modules\":[{\"__typename\":\"richText\",\"sys\":{\"id\":\"2lSiTEfv2FDKFWH5Cxyp7S\",\"createdAt\":\"2025-10-20T16:26:00.002Z\",\"updatedAt\":\"2026-02-24T04:58:08.486Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e What is the MetaMask Rewards program?\",\"title\":\"What is the MetaMask Rewards program?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"MetaMask Rewards is the official crypto rewards and loyalty program built into MetaMask’s self-custodial wallet. With MetaMask Rewards, you earn real world value every time you trade perps or swap tokens through MetaMask mobile app and extension. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"6gLXDRuU2nyMcN1xu8gA1z\",\"createdAt\":\"2025-10-20T16:34:17.412Z\",\"updatedAt\":\"2026-02-24T04:58:08.505Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e How does MetaMask Rewards work?\",\"title\":\"How does MetaMask Rewards work?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"As soon as you opt-in to MetaMask Rewards, you'll receive points for trading perps or swapping tokens through MetaMask. \"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Monitor your points and track your progress through each level, with the MetaMask Rewards dashboard on MetaMask mobile app. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"5TUhpJBrDtYFRxmowsXtkk\",\"createdAt\":\"2025-10-20T16:26:56.783Z\",\"updatedAt\":\"2026-02-24T04:58:08.527Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e What benefits can I receive from MetaMask Rewards in Season 1?\",\"title\":\"What benefits can I receive from MetaMask Rewards in Season 1?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Trade perps and swap tokens through MetaMask to earn onchain and IRL rewards like: \"}]},{\"nodeType\":\"unordered-list\",\"data\":{},\"content\":[{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"A cut of over $30 million in $LINEA\"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Trading fee discounts \"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Future token allocations\"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Exclusive offers \"}]}]}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[]}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Stay tuned for more MetaMask Rewards perks being announced soon...\"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"6uixM6aKqpNuNQxS6zF3kR\",\"createdAt\":\"2025-10-20T16:27:24.261Z\",\"updatedAt\":\"2026-02-24T04:58:08.546Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e How many MetaMask Rewards points can I earn?\",\"title\":\"How many MetaMask Rewards points can I earn?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"There is no upper limit to the maximum amount of MetaMask Rewards points you can earn through swaps and trades. The more points you earn, the more $LINEA you will qualify for. Each season, your total progress will reset. Your trading activity from the previous season will be reflected through bonuses you'll receive at the start of the new season.\"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"26AyyegdaZfZ2hJkL9GKoo\",\"createdAt\":\"2025-10-20T16:34:17.429Z\",\"updatedAt\":\"2026-02-24T04:58:08.563Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e If I reach the highest level of MetaMask Rewards, will my points be capped?\",\"title\":\"If I reach the highest level of MetaMask Rewards, will my points be capped?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"No, you will continue to receive rewards based on the total points you earn. There is no upper limit to the maximum amount of MetaMask Rewards points you can earn through swaps and trades. The more points you earn, the more $LINEA you will qualify for. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"4Y3rqcQ5xncgKluy7W4O4M\",\"createdAt\":\"2025-10-20T16:28:19.422Z\",\"updatedAt\":\"2026-03-06T17:26:37.686Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e How do I redeem MetaMask Rewards points?\",\"title\":\"How do I redeem MetaMask Rewards points?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"After you opt-in to MetaMask Rewards, you’ll automatically receive points for every eligible trade that you make. To view and claim your MetaMask Rewards: \"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"1. Tap the \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Rewards\"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\" tab on your MetaMask mobile app.\"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"2. Tap \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Levels\"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\" to view the list of your unlocked rewards.\"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"3. Claim available rewards, and track your progress. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"609jkTmD4MnOW8gLAb8hOy\",\"createdAt\":\"2025-10-20T16:34:17.447Z\",\"updatedAt\":\"2026-03-11T05:05:54.178Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e What web3 loyalty programs are there?\",\"title\":\"What crypto loyalty programs are there?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Crypto loyalty programs for traders include MetaMask Rewards, Binance Rewards, Trust Wallet Earn, and OKX Wallet incentives. MetaMask Rewards is crypto's leading loyalty program, featuring exclusive token drops and perks.\"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"2ZObA1Rwac2b44I2LIuXIj\",\"createdAt\":\"2025-10-20T16:34:17.464Z\",\"updatedAt\":\"2026-02-24T04:58:08.631Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e How many MetaMask Rewards points can I receive?\",\"title\":\"How many MetaMask Rewards points can I receive?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"There is no limit on the maximum amount of MetaMask Rewards points you can receive when you trade crypto on MetaMask during Season 1. After each season, your progress will reset. Remember: your trading activity from the previous season will earn bonuses that you'll receive at the start of the subsequent season.\"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"DpConPF3EHQNrVVA12XuH\",\"createdAt\":\"2025-10-20T16:34:17.480Z\",\"updatedAt\":\"2026-02-24T04:58:08.652Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e Does MetaMask have a rewards program?\",\"title\":\"Does MetaMask have a rewards program?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Yes! MetaMask Rewards is the only official rewards and crypto loyalty program for the MetaMask self-custodial wallet. To start earning MetaMask Rewards points today, update your MetaMask mobile app on iOS or Android to version 7.57 or higher, and opt-in via the Rewards tab in the app. Make sure to add all the accounts you use for trading to the Rewards program to maximize your total points. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"1RQqQzX9tVKJoPzEw4yGuk\",\"createdAt\":\"2025-10-20T16:29:55.123Z\",\"updatedAt\":\"2026-02-24T04:58:08.670Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e What are the eligibility requirements for joining MetaMask Rewards program?\",\"title\":\"What are the eligibility requirements for joining MetaMask Rewards program?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"To join MetaMask Rewards, all you need to do is update your MetaMask mobile app on iOS or Android to version 7.57 or higher. Open your MetaMask app, and tap the \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Rewards\"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\" tab at the bottom of your screen to get started. Once you opt-in, you'll automatically receive points for all eligible transactions—like trading perps or swapping tokens. \"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"MetaMask Rewards is currently unavailable in the United Kingdom, and in any other regions where MetaMask services are not supported.\"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"5fyqQCe1Hv0a7jQzV76GUu\",\"createdAt\":\"2025-10-20T16:34:17.496Z\",\"updatedAt\":\"2026-02-24T04:58:08.690Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e Does MetaMask Rewards offer a sign-up bonus?\",\"title\":\"Does MetaMask Rewards offer a sign-up bonus?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Yes! You’ll receive 250 bonus points when you sign-up today (subject to eligibility).\"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"7gxOQjiL1F8iTHojTALzwk\",\"createdAt\":\"2025-10-20T16:30:30.681Z\",\"updatedAt\":\"2026-02-24T04:58:08.709Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e Does MetaMask Rewards offer referral bonuses or finder fees?\",\"title\":\"Does MetaMask Rewards offer referral bonuses or finder fees?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Yes! If you refer a friend to MetaMask Rewards, and they successfully use your code when signing-up, they’ll receive an additional 250 bonus points for a total sign-up bonus of 500 points, and you’ll receive 10 points every time they earn 50 points from trading. Win win. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"7pew3X492IAGwo0ViQE9oJ\",\"createdAt\":\"2025-10-20T16:30:49.089Z\",\"updatedAt\":\"2026-02-24T04:58:08.732Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e How can I refer others to MetaMask Rewards?\",\"title\":\"How can I refer others to MetaMask Rewards?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Tap on the referrals icon at the top of the Rewards section on MetaMask mobile. From here, you can find your referral code and link. When someone signs up for MetaMask Rewards using your referral code, they will earn 250 additional points for a total sign-up bonus of 500 points, and you’ll receive 10 points for every 50 points they earn from trading. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"1Ndp63XHJiwbSmRhoZXm69\",\"createdAt\":\"2025-10-20T16:31:16.452Z\",\"updatedAt\":\"2026-02-24T04:58:08.748Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e Where can I see how many MetaMask Rewards points I have?\",\"title\":\"Where can I see how many MetaMask Rewards points I have?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Check out your MetaMask Rewards points at any time by opening MetaMask mobile app and tapping on the \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Rewards\"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\" tab at the bottom of your screen. This is where you’ll find your total points, progress towards the next reward level, any active boosts, and additional details about your rewards. \"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"To get a full breakdown of your points history, including trades and referrals, go to the \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Activity\"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\" tab within the Rewards section on MetaMask Mobile. This is where you’ll find a list of all actions that have earned you points. You can tap any entry for more information about each transaction. Note: points may take up to one hour to show up in the Activity tab after a trade. \"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"\\nTo get a breakdown of how many referrals you have and how many points you’ve earned from referrals, go to the \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Referrals \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"page by tapping the icon at the top of the Rewards section on MetaMask Mobile. Here you can also find your referral code and link to share with others. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"7MckWRCwCWNeoGwbtWzOqp\",\"createdAt\":\"2025-10-20T16:34:17.570Z\",\"updatedAt\":\"2026-02-24T04:58:08.764Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e What are MetaMask Rewards boosts?\",\"title\":\"What are MetaMask Rewards boosts?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Boosts are multipliers that increase the number of points you earn for specific trades or activities in MetaMask Rewards. For example, swaps made on the Linea network earn double points thanks to a 2x boost. Some boosts apply to all users for a limited time, while others unlock as you reach higher reward levels.\"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"\\nYou can check for active boosts by going to the \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Rewards\"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\" tab in the MetaMask mobile app, where any boosts affecting your account will be displayed. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"wDR3aHgbgTHZz7IqrxLOf\",\"createdAt\":\"2025-10-20T16:31:51.451Z\",\"updatedAt\":\"2026-02-24T04:58:08.780Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e Can boosts be combined?\",\"title\":\"Can boosts be combined?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Yes, you can earn additional points in a single trade from multiple boosts. For example, if a 100% boost is active for swaps on Linea, and another 50% boost is active for swaps made using the mobile app, those can be combined for a total 150% boost, a 2.5x multiplier. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"4cS4oQbubiEmd9kunnG9HJ\",\"createdAt\":\"2025-10-20T16:32:07.274Z\",\"updatedAt\":\"2026-02-24T04:58:08.798Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e I’ve been using MetaMask for years. Will I get points for swaps and bridges I did in the past? \",\"title\":\"I’ve been using MetaMask for years. Will I get points for swaps and bridges I did in the past? \",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Yes! You will earn a loyalty bonus for each account you add to your MetaMask Rewards profile with at least $1,250 USD of historical swaps and bridging volume. Loyalty bonuses are awarded in increments of 250 for each $1,250 of past volume, up to a total of 50,000 points. When you add an account that qualifies for a loyalty bonus, the bonus will appear within a couple hours in the \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Activity \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"tab of the Rewards section on MetaMask Mobile. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"15dFfX6ICGHIaeW90vMJVw\",\"createdAt\":\"2025-10-20T16:32:23.668Z\",\"updatedAt\":\"2026-02-24T04:58:08.817Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e How can I add more accounts to my Rewards profile? \",\"title\":\"How can I add more accounts to my Rewards profile? \",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Tap the settings icon at the top of the Rewards section of MetaMask Mobile to go to the \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Settings\"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\" page. From here, you can add more accounts to your Rewards profile. Add as many trading accounts as you have to aggregate your activity and earn more points! Note: Hardware wallet accounts are not supported yet. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"3A8sz9iB4zX471cQNfw56e\",\"createdAt\":\"2025-10-20T16:32:44.392Z\",\"updatedAt\":\"2026-02-24T04:58:08.833Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e Why is Rewards asking for permission to track my activity? \",\"title\":\"Why is Rewards asking for permission to track my activity?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"In order to calculate your points, MetaMask Rewards tracks your trading activity on each account that you add to the program. We do not share this data with third parties, and we never sell your data. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"28iQCxuHyRKcQszyDomw9N\",\"createdAt\":\"2025-10-20T16:33:05.652Z\",\"updatedAt\":\"2026-02-24T04:58:08.849Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e I joined MetaMask Rewards but I no longer wish to participate. Can I opt out? \",\"title\":\"I joined MetaMask Rewards but I no longer wish to participate. Can I opt out? \",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"You can opt out of MetaMask Rewards at any time by tapping the settings icon at the top of the Rewards section of MetaMask Mobile to go to the \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Settings \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"page. At the bottom of this page, you’ll find the option to opt out of the program. Note: opting out will erase your progress. If you rejoin the program at a later date, you’ll start back at level 1. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"2oOaqfovZgVwkfotHvptYC\",\"createdAt\":\"2025-10-20T16:34:17.587Z\",\"updatedAt\":\"2026-02-24T04:58:08.867Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e Have more questions about MetaMask Rewards? \",\"title\":\"Have more questions about MetaMask Rewards?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Need extra help using MetaMask Rewards? We got you. Visit the MetaMask Rewards Support hub \"},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"https://support.metamask.io/manage-crypto/metamask-rewards\"},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"here\"}]},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\". Check out additional FAQs, explore available countries, dive into detailed guides, and get assistance in your local language. \"}]}]}},{\"__typename\":\"richText\",\"sys\":{\"id\":\"6r6TSd0B83hLPlNdE6gvWY\",\"createdAt\":\"2025-10-20T16:33:44.299Z\",\"updatedAt\":\"2026-02-24T04:58:08.884Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e Why am I reaching a 404 when I scan the page QR code to join MetaMask Rewards?\",\"title\":\"Why am I reaching a 404 when I scan the page QR code to join MetaMask Rewards?\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"To join MetaMask Rewards, make sure you're using the latest version of MetaMask mobile. Getting started is easy. Just update MetaMask mobile app on iOS or Android to version 7.57 or higher.\"}]}]}},{\"__typename\":\"moduleContainer\",\"sys\":{\"id\":\"5ef0A4VWFGCybnUO99CqZ2\",\"createdAt\":\"2026-03-17T18:17:08.012Z\",\"updatedAt\":\"2026-03-17T18:17:08.012Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleContainer\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"internalName\":\"Rewards \u003e FAQs \u003e Disclaimer\",\"component\":\"disclaimer\",\"title\":\"Disclaimer\",\"modules\":[{\"__typename\":\"richText\",\"sys\":{\"id\":\"2oyhnuZMSyE97xzCJ2BTJb\",\"createdAt\":\"2025-10-20T16:34:02.925Z\",\"updatedAt\":\"2026-02-24T04:58:08.900Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"richText\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Rewards \u003e FAQs \u003e Disclaimer\",\"title\":\"Disclaimer\",\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Any Linea token payout will be based on a set of activities. This estimate is based on our projection of those activities and the current price of the Linea token, both of which are subject to change.\"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"MetaMask Rewards does not constitute an offer, recommendation, or solicitation to engage with digital assets, nor does it provide advice in any form. It is not intended for jurisdictions where such participation would violate laws or regulations. Participants must ensure compliance with applicable restrictions. Digital assets are speculative, volatile, and high-risk, with the potential for complete loss of value.\"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"The value of digital assets, including rewards, may fluctuate significantly. Rewards earned may differ in value at the time of distribution, leading to potential gains or losses.\"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Participants are responsible for all taxes, fees, and expenses associated with receiving and using rewards, such as gas fees and transaction costs.\"}]}]}}]}],\"colorPalette\":{\"__typename\":\"colorPalettes\",\"sys\":{\"id\":\"7tNuovTj2hFDbW2xHRAaAI\",\"createdAt\":\"2024-06-07T13:36:07.967Z\",\"updatedAt\":\"2026-01-23T04:00:11.052Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"colorPalettes\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"internalName\":\"COMPLEMENTARY_GREEN_DARK_PURPLE_LIGHT\",\"themeAudience\":\"Complementary\",\"complementaryColor\":\"Green dark / Purple light\"}},{\"__typename\":\"moduleContainer\",\"sys\":{\"id\":\"5Jqx0NZDE2fKCAKHO6LKXm\",\"createdAt\":\"2025-10-20T16:40:21.331Z\",\"updatedAt\":\"2026-02-24T04:58:08.917Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"moduleContainer\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"internalName\":\"Rewards \u003e Related articles\",\"component\":\"related-articles\",\"title\":\"Related articles\",\"modules\":[{\"__typename\":\"cta\",\"sys\":{\"id\":\"3AT1Y9gps4UY8Ggct89hB7\",\"createdAt\":\"2024-10-30T09:20:38.542Z\",\"updatedAt\":\"2026-05-19T05:36:17.974Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"cta\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"internalName\":\"Buy Crypto \u003e Related articles \u003e CTA\",\"title\":\"All articles\",\"href\":\"/news\",\"external\":false,\"isLarge\":false,\"dataTestId\":\"all-articles-d2ded\"},{\"__typename\":\"news\",\"sys\":{\"id\":\"3Qdsq5UIXxr0xTyBxadk9L\",\"createdAt\":\"2025-10-28T13:34:27.693Z\",\"updatedAt\":\"2026-05-19T05:36:18.391Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"news\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"latest\"}},{\"sys\":{\"type\":\"Link\",\"linkType\":\"Tag\",\"id\":\"product\"}}],\"concepts\":[]},\"title\":\"Introducing MetaMask Rewards\",\"slug\":\"introducing-metamask-rewards\",\"excerpt\":\"Level up your trades.\",\"readingTime\":\"2 minutes\",\"publishedDate\":\"2026-05-06\",\"heroImage\":{\"sys\":{\"id\":\"2O08JroBPwPYYkbqGAmhNj\",\"createdAt\":\"2025-10-27T21:48:50.593Z\",\"updatedAt\":\"2025-10-27T21:48:50.593Z\",\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"title\":\"Introducing MetaMask Rewards\",\"description\":\"Introducing MetaMask Rewards\",\"file\":{\"url\":\"//images.ctfassets.net/clixtyxoaeas/2O08JroBPwPYYkbqGAmhNj/3f91e190b732c72ef9860d377946a2b4/Blog_â___Rewards_Launch__1_.png\",\"details\":{\"size\":4381365,\"image\":{\"width\":3840,\"height\":2160}},\"fileName\":\"Blog – Rewards Launch (1).png\",\"contentType\":\"image/png\"}},\"seo\":{\"__typename\":\"seo\",\"sys\":{\"id\":\"cuCYby7LhoMhmKjj2qHWm\",\"createdAt\":\"2025-10-28T02:43:48.124Z\",\"updatedAt\":\"2026-05-19T05:36:18.430Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"seo\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"internalName\":\"Introducing MetaMask Rewards\",\"title\":\"Introducing MetaMask Rewards\",\"description\":\"Compete in trading challenges, claim airdrops, and access exclusive benefits with MetaMask Rewards—available now on MetaMask Mobile.\",\"sharedImage\":{\"sys\":{\"id\":\"7Gw0JO3ZePFUaT23XWvIVa\",\"createdAt\":\"2025-10-21T16:50:35.793Z\",\"updatedAt\":\"2025-10-21T16:50:35.793Z\",\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"title\":\"Introducing MetaMask Rewards\",\"description\":\"Introducing MetaMask Rewards\",\"file\":{\"url\":\"//images.ctfassets.net/clixtyxoaeas/7Gw0JO3ZePFUaT23XWvIVa/548c6cd44123e05ec9826e904b32b426/Blog_â___Rewards_Launch.png\",\"details\":{\"size\":4381365,\"image\":{\"width\":3840,\"height\":2160}},\"fileName\":\"Blog – Rewards Launch.png\",\"contentType\":\"image/png\"}},\"noIndex\":false,\"noFollow\":false},\"colorPalette\":{\"__typename\":\"colorPalettes\",\"sys\":{\"id\":\"2E44E8vbkJD6iNI7asB56e\",\"createdAt\":\"2024-06-07T13:27:28.888Z\",\"updatedAt\":\"2026-04-13T13:00:19.497Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"colorPalettes\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"internalName\":\"CONSUMER_PURPLE_WHITE\",\"themeAudience\":\"Consumer\",\"consumerColor\":\"Purple white\"},\"content\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"UPDATE, May 6 2026: MetaMask Rewards is back with trading challenges, airdrops, and a new Benefits tab powered by theMiracle—surfacing perks and token allocations based on what's in your wallet. Claim Pudgy Penguins and Claynosaurz benefits now, with more from Decentraland, Doodles, and Chimpers HQ coming soon.Visit \"},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"https://metamask.io/rewards\"},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"metamask.io/rewards\"}]},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\" to get started.\\n\\nThe original article below covers MetaMask Rewards Season 1.\"}]},{\"nodeType\":\"hr\",\"data\":{},\"content\":[]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"UPDATE, Feb 23 2026: MetaMask Rewards Season 1 has now ended, and the claim window is closed. \"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Get more out of your crypto: \"},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"https://link.metamask.io/rewards\"},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"MetaMask Rewards\"}]},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\" program is here. Earn points for trading, swapping, spending, referring, and for your past activity too.  \\n\\nAs you collect points, you’ll climb reward levels that unlock new perks and benefits across MetaMask. Points are based on trade volume and can be redeemed for Rewards like fee discounts, token allocations, and partner offers. This is just the beginning, with new incentives and updated rewards rolling out every season. \"}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"How does the MetaMask Rewards points system work?\"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Each season of MetaMask Rewards consists of different levels. As you trade, your activity translates into points that move you into higher levels with greater perks.\"}]},{\"nodeType\":\"heading-3\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Season 1 levels (Oct 28 – Jan 23)\"}]},{\"nodeType\":\"unordered-list\",\"data\":{},\"content\":[{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Level 1: Origin (0 points)\"}]},{\"nodeType\":\"unordered-list\",\"data\":{},\"content\":[{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\" Rewards: None\"}]}]}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Level 2: Frontier (\u003e1,000 points) \"}]},{\"nodeType\":\"unordered-list\",\"data\":{},\"content\":[{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Rewards: Linea token allocation proportional to your total points, claimable at the end of the season.\"}]}]}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Level 3: Sylvana (\u003e25,000 points)\"}]},{\"nodeType\":\"unordered-list\",\"data\":{},\"content\":[{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Rewards: A 24-hour 50% boost on points earned from swaps \u0026 perps trades, and all rewards from previous levels.\"}]}]}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Level 4: Oceania (\u003e50,000 points)\"}]},{\"nodeType\":\"unordered-list\",\"data\":{},\"content\":[{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Rewards: A 50% discount on perps trading fees, and all rewards from previous levels.\"}]}]}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Level 5: Denalia (\u003e100,000 points)\"}]},{\"nodeType\":\"unordered-list\",\"data\":{},\"content\":[{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Rewards: Priority customer support for the duration of the season, plus a 3-day 50% boost on points earned from swaps \u0026 perps trades, and all rewards from previous levels.\"}]}]}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Level 6: Titana (\u003e1,000,000 points)\"}]},{\"nodeType\":\"unordered-list\",\"data\":{},\"content\":[{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Rewards: A 65% discount on perps fees plus access to the AlphaFoxes club for top users, and all rewards from previous levels.\"}]}]}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Level 7: Utopia (\u003e5,000,000 points)\"}]},{\"nodeType\":\"unordered-list\",\"data\":{},\"content\":[{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Rewards: A free MetaMask Metal Card for one year (claimable at season’s end), and all rewards from previous levels.\"}]}]}]}]}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Points you can earn per activity\"}]},{\"nodeType\":\"unordered-list\",\"data\":{},\"content\":[{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Swapping tokens: 8 points per $10 swapping on or across supported networks\"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Trading perps: 1 point per $10 opening, closing, or executing take profit/stop loss trades\"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Trading prediction markets: 2 points for every $1 you trade\"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Spending on MetaMask Card: 1 point for every $1 USD you spend\"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Trading activity via your referrals: 10 points for every 50 points your referrals earn through trading\"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Past activity: 250 points for every $1250 of past swapping and bridging, up to a total of 50K points per user. (Note: This includes trades before Oct 15 2025.)\"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"OpenSea: Get a 500 points boost when you join MetaMask Rewards now until Jan 23 by using the referral code OPNSEA. If you're already part of the \"},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"https://opensea.io/rewards\"},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"OpenSea Rewards Program\"}]},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\", you’ll receive extra points depending on your OpenSea Chest tier in Wave 4\"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\". \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"italic\"}],\"value\":\"NB: To be eligible for OpenSea bonus points, make sure the wallet address you use to sign up for MetaMask Rewards is the same wallet address where you receive your OpenSea Treasure Chest.\"}]},{\"nodeType\":\"unordered-list\",\"data\":{},\"content\":[{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Iron - Steel: 100 \"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Titanium - Cobalt: 250\"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Amethyst - Sapphire: 500\"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Ruby - Diamond: 1000\"}]}]}]}]}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"You can link multiple MetaMask accounts to combine points and make progress faster. Imported wallets and historical activity also count toward bonuses.\"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Some rewards, like points boosts and fee discounts, are applied automatically or can be redeemed during the season. Others, like token allocations, are available after the season ends during a dedicated claim window.\"}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"How to get started with MetaMask Rewards\"}]},{\"nodeType\":\"ordered-list\",\"data\":{},\"content\":[{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Update your MetaMask mobile app on iOS or Android to version 7.57 or higher.\"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Open MetaMask and go to the \"},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"https://metamask.io/rewards?_branch_match_id=1542951385750209463\u0026_branch_referrer=H4sIAAAAAAAAA8soKSkottLXz8nMy9bLTS1JzE0sztbLzNcvSi1PLEoptq8rSk1LLSrKzEuPTyrKLy9OLbJ1zijKz00FAJSyjws6AAAA\"},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Rewards tab\"}]},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\" in the bottom menu.\"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Opt in to \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Rewards\"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\". Your accounts will stay enrolled.\"}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"Trade crypto on MetaMask to start earning points.\"}]}]}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"You’ll see your points increase as you trade. Easily track your progress, levels, and unlocked rewards anytime from the \"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Rewards\"},{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\" tab.\"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Ready to level up your trades? \"},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"https://link.metamask.io/rewards\"},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Update MetaMask Mobile App\"}]},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\" to version 7.57 or later and opt into Rewards to get started.\"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"For more info, visit our \"},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"https://metamask.io/rewards#frequently-asked-questions\"},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"underline\"},{\"type\":\"bold\"}],\"value\":\"Rewards FAQs\"}]},{\"nodeType\":\"text\",\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\". \"}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"data\":{},\"marks\":[],\"value\":\"\\n\"}]}]},\"authors\":[{\"__typename\":\"author\",\"sys\":{\"id\":\"B5oi3kQ38JIoAnt19mRGb\",\"createdAt\":\"2024-09-04T05:24:04.630Z\",\"updatedAt\":\"2026-05-06T08:25:39.957Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"author\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"picture\":{\"sys\":{\"id\":\"1QvtYPXr8vqhWGbnWtE9Uc\",\"createdAt\":\"2024-09-04T05:14:00.977Z\",\"updatedAt\":\"2025-02-20T04:30:24.564Z\",\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"title\":\"christian-montoya\",\"file\":{\"url\":\"//images.ctfassets.net/clixtyxoaeas/1QvtYPXr8vqhWGbnWtE9Uc/71ef8158db641aebeeb85a69b8739f7f/christian-montoya.png\",\"details\":{\"size\":455966,\"image\":{\"width\":720,\"height\":720}},\"fileName\":\"christian-montoya.png\",\"contentType\":\"image/png\"}},\"slug\":\"christian-montoya\",\"name\":\"Christian Montoya\",\"description\":\"Christian Montoya is the Director of Product for Growth at MetaMask. Prior to this, he led the Network Expansion initiative, laying the foundation for MetaMask to become a multichain wallet with the launch of Solana accounts. He was also Product Lead for MetaMask Snaps, a novel developer platform that allows anyone to safely expand the features of MetaMask with custom mini-apps called “Snaps.”\\n\\nBefore joining MetaMask, Christian held numerous roles at organizations both big and small, working in gaming, education, music technology, artificial intelligence, and data privacy. He is also an NFT creator and junior Solidity developer, having independently launched three NFT projects to date.\",\"socialLinks\":{\"__typename\":\"listBlock\",\"sys\":{\"id\":\"421ae013e45b8a2bfb93aa72\",\"createdAt\":\"2024-09-04T05:23:46.637Z\",\"updatedAt\":\"2026-05-19T05:36:18.471Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"listBlock\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Christian Montoya \u003e Social Links\",\"items\":[{\"__typename\":\"cta\",\"sys\":{\"id\":\"d1162abab71a77131b18abf4\",\"createdAt\":\"2024-09-04T05:23:45.586Z\",\"updatedAt\":\"2026-05-19T05:36:18.486Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"cta\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"internalName\":\"Christian Montoya \u003e Social links \u003e Twitter\",\"title\":\"Twitter\",\"href\":\"https://twitter.com/MidwitMilhouse\",\"external\":true,\"rel\":\"noopener noreferrer\"},{\"__typename\":\"cta\",\"sys\":{\"id\":\"ffc95f97c75de9363309c0e5\",\"createdAt\":\"2024-09-04T05:23:46.088Z\",\"updatedAt\":\"2026-05-19T05:36:18.502Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"cta\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"internalName\":\"Christian Montoya \u003e Social links \u003e LinkedIn\",\"title\":\"LinkedIn\",\"href\":\"https://www.linkedin.com/in/christianmontoya/\",\"external\":true,\"rel\":\"noopener noreferrer\"}]},\"position\":\"Director of Product for Growth, MetaMask\",\"education\":\"BS, Cornell University\",\"educationalInstitutions\":[\"Cornell University\"]},{\"__typename\":\"author\",\"sys\":{\"id\":\"7eFOILi1tizdGgqOorH8fo\",\"createdAt\":\"2025-02-20T04:33:52.230Z\",\"updatedAt\":\"2026-06-26T08:12:06.382Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"author\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"picture\":{\"sys\":{\"id\":\"7JHrmjhpiKajxi3VM4wc1Q\",\"createdAt\":\"2024-04-11T14:39:14.671Z\",\"updatedAt\":\"2024-04-11T14:39:14.671Z\",\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"title\":\"avatar\",\"file\":{\"url\":\"//images.ctfassets.net/clixtyxoaeas/7JHrmjhpiKajxi3VM4wc1Q/2d67492953bf745d38c470f0bd1fa852/avatar.png\",\"details\":{\"size\":2108,\"image\":{\"width\":77,\"height\":76}},\"fileName\":\"avatar.png\",\"contentType\":\"image/png\"}},\"slug\":\"gabriela-helfet\",\"name\":\"Gabriela Helfet\",\"description\":\"Gabriela Helfet is the Senior Content Manager at Consensys, where she's built rigorous systems for content and copy production at scale—from original writing to AI-assisted generation, editorial review, and fact-checking. She has spent over a decade at the intersection of culture and technology, collaborating with brands like Prada, Nike, Bang \u0026 Olufsen, and Levi's, artists like Virgil Abloh, Thom Yorke, and Peggy Gou, and institutions like the New Museum, Gagosian Gallery, and Frieze. Her work and words have appeared in just about every digital and analog format under the sun.\",\"socialLinks\":{\"__typename\":\"listBlock\",\"sys\":{\"id\":\"b8c9001d7c6a0cad78d06abb\",\"createdAt\":\"2025-02-20T04:33:44.312Z\",\"updatedAt\":\"2026-05-19T05:36:18.068Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"listBlock\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"name\":\"Gabriela Helfet \u003e Social Links\",\"items\":[{\"__typename\":\"cta\",\"sys\":{\"id\":\"aafb97c11812cfe283de728e\",\"createdAt\":\"2025-02-20T04:33:43.604Z\",\"updatedAt\":\"2026-05-19T05:36:18.332Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"cta\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"internalName\":\"Gabriela Helfet \u003e Social links \u003e LinkedIn\",\"title\":\"LinkedIn\",\"href\":\"https://www.linkedin.com/in/gabriela-helfet\",\"external\":true,\"rel\":\"noopener noreferrer\",\"isLarge\":false,\"dataTestId\":\"not-generated\"},{\"__typename\":\"cta\",\"sys\":{\"id\":\"X6gXDNfvZy3AStXyiWvlV\",\"createdAt\":\"2026-03-20T09:42:18.764Z\",\"updatedAt\":\"2026-05-19T05:36:18.350Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"cta\"}},\"locale\":\"en\"},\"metadata\":{\"tags\":[],\"concepts\":[]},\"internalName\":\"Gabriela Helfet \u003e Social links \u003e Twitter\",\"title\":\"Twitter\",\"href\":\"#\",\"external\":false,\"isLarge\":false,\"dataTestId\":\"not-generated\"}]},\"position\":\"Senior Content Manager\",\"expertise\":\"Technology, crypto, web3, culture, emerging tech, music, art, film, luxury, brand strategy, content direction, prompt engineering\"}]},{\"__typename\":\"externalArticle\",\"sys\":{\"id\":\"3R1OsjhPvtjgWjsm27Bwm7\",\"createdAt\":\"2025-10-20T16:37:46.111Z\",\"updatedAt\":\"2026-01-23T04:00:11.571Z\",\"contentType\":{\"sys\":{\"type\":\"Link\",\"linkType\":\"ContentType\",\"id\":\"externalArticle\"}}