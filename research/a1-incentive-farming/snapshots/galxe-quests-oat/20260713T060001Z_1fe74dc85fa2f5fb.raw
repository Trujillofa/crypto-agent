\":\"Understanding the GAL Token\",\"href\":\"/about/gal/tokenomics\"}]},{\"group\":\"Legal\",\"pages\":[{\"title\":\"Galxe Terms of Use\",\"description\":\"Effective Date: September 10th, 2025\",\"href\":\"/about/legal/terms-of-service\"},{\"title\":\"Galxe Privacy Policy\",\"description\":\"Last Updated: September 10, 2025\",\"href\":\"/about/legal/privacy-policy\"},{\"title\":\"Staking Terms and Conditions\",\"description\":\"Last Updated: April 23, 2024\",\"href\":\"/about/legal/staking-terms-and-conditions\"},{\"title\":\"Galxe Passport Terms of Use\",\"description\":\"Effective Date: March 1, 2025\",\"href\":\"/about/legal/passport-terms-of-use\"},{\"title\":\"Galxe Passport Privacy Policy\",\"description\":\"Last Updated: March 1, 2025\",\"href\":\"/about/legal/passport-privacy-policy\"}]},{\"group\":\"Community Programs\",\"pages\":[{\"title\":\"Galxe Contributor Program\",\"sidebarTitle\":\"Contributor Program\",\"description\":\"Galxe contributors are the backbone of the Galxe community and play a vital role in shaping the future of Web3.\",\"href\":\"/about/community-programs/galxe-contributor\"},{\"title\":\"Galxe Astronaut Program\",\"sidebarTitle\":\"Astronaut Program\",\"description\":\"Dive in to learn how you can accrue points and progress through the tiers to unlock an array of exciting rewards in Galxe Astronaut Program.\",\"href\":\"/about/community-programs/galxe-astronaut\"}]}]},{\"tab\":\"Galxe Identity Protocol\",\"groups\":[{\"group\":\"Getting Started\",\"pages\":[{\"title\":\"Galxe Identity Protocol\",\"description\":\"Where Identity Meets Privacy, Where You Take Control\",\"sidebarTitle\":\"Identity Protocol\",\"href\":\"/identity/introduction\"},{\"title\":\"TypeScript SDK\",\"sidebarTitle\":\"SDK\",\"description\":null,\"href\":\"/identity/sdk\"}]},{\"group\":\"Tutorials\",\"pages\":[{\"title\":\"Proof Generation \u0026 Verification Workflow\",\"description\":\"Hands-On Zero-Knowledge Proofs with Galxe Identity Protocol\",\"href\":\"/identity/tutorials/simple-workflow\"},{\"title\":\"Proof Aggregation \u0026 Verification with NEBRA\",\"description\":\"Utilizing NEBRA as proof aggregator\",\"href\":\"/identity/tutorials/use-nebra-upa\"}]},{\"group\":\"Introduction\",\"pages\":[{\"title\":null,\"description\":null,\"href\":\"/identity/introduction/background\"},{\"title\":null,\"description\":null,\"href\":\"/identity/introduction/overview\"},{\"title\":null,\"description\":null,\"href\":\"/identity/introduction/concepts\"},{\"title\":null,\"description\":null,\"href\":\"/identity/introduction/roles\"},{\"title\":\"Case Studies\",\"description\":null,\"href\":\"/identity/introduction/case-studies\"}]},{\"group\":\"Specification\",\"pages\":[{\"title\":null,\"description\":null,\"href\":\"/identity/specification/overview\"},{\"title\":\"Type DSL\",\"description\":null,\"href\":\"/identity/specification/type-dsl\"},{\"title\":\"Primitive Types\",\"description\":null,\"href\":\"/identity/specification/primitive-types\"},{\"title\":\"Credential Format\",\"description\":null,\"href\":\"/identity/specification/credential-format\"},{\"title\":\"Technical Components\",\"description\":null,\"href\":\"/identity/specification/technical-components\"},{\"title\":null,\"description\":null,\"href\":\"/identity/specification/workflow\"}]},{\"group\":\"Use Cases\",\"pages\":[{\"title\":\"Galxe Passport\",\"description\":\"Issue and verify Galxe Passport v2 credential\",\"href\":\"/identity/use-cases/galxe-passport\"},{\"title\":null,\"description\":null,\"href\":\"/identity/use-cases/ideas\"}]},{\"group\":\"Future Works\",\"pages\":[{\"title\":null,\"description\":null,\"href\":\"/identity/future-works/future-works\"}]},{\"group\":\"Resources\",\"pages\":[{\"title\":\"Contracts\",\"description\":null,\"href\":\"/identity/resources/contracts\"}]}]},{\"tab\":\"Galxe Quest\",\"groups\":[{\"group\":\"Getting Started\",\"pages\":[{\"title\":\"What is Galxe Quest\",\"description\":null,\"href\":\"/quest/introduction\"}]},{\"group\":\"Credential Advanced\",\"pages\":[{\"group\":\"Overview\",\"pages\":[{\"title\":\"Introduction\",\"description\":null,\"href\":\"/quest/credential-api/overview/introduction\"},{\"title\":\"CORS Check\",\"description\":\"The Galxe platform uses a Cross-Origin Resource Sharing (CORS) check mechanism to ensure that the target API explicitly authorizes calls from the Galxe backend. The role of CORS is to verify whether the API accepts cross-origin requests, ensuring the legality and security of interactions. The target API can authorize access for Galxe by specifying the source or using a wildcard (*).\",\"href\":\"/quest/credential-api/overview/cross-domain-check\"}]},{\"group\":\"API Credential\",\"pages\":[{\"title\":\"Introduction\",\"description\":null,\"href\":\"/quest/credential-api/api-cred/introduction\"},{\"title\":\"Config\",\"description\":\"Learn how to configure API Credential.\",\"href\":\"/quest/credential-api/api-cred/config\"}]},{\"group\":\"REST Credential\",\"pages\":[{\"title\":\"Introduction\",\"description\":null,\"href\":\"/quest/credential-api/rest-cred/introduction\"},{\"title\":\"Single Dimensional Config\",\"description\":\"Learn how to configure REST Single-Dimensional Credential\",\"href\":\"/quest/credential-api/rest-cred/single-config\"},{\"title\":\"Multi Dimensional Config\",\"description\":\"Learn how to configure REST Multi-Dimensional Credential\",\"href\":\"/quest/credential-api/rest-cred/multi-config\"}]},{\"group\":\"GraphQL Credential\",\"pages\":[{\"title\":\"Introduction\",\"description\":null,\"href\":\"/quest/credential-api/graphql-cred/introduction\"},{\"title\":\"Single Dimensional Config\",\"description\":\"Learn how to configure GraphQL Single-Dimensional Credential\",\"href\":\"/quest/credential-api/graphql-cred/single-config\"},{\"title\":\"Multi Dimensional Config\",\"description\":\"Learn how to configure GraphQL Multi-Dimensional Credential\",\"href\":\"/quest/credential-api/graphql-cred/multi-config\"}]},{\"group\":\"Contract Query Credential\",\"pages\":[{\"title\":\"Introduction\",\"description\":null,\"href\":\"/quest/credential-api/contract-query-cred/introduction\"},{\"title\":\"Config\",\"description\":\"Learn how to configure Contract Query Credential\",\"href\":\"/quest/credential-api/contract-query-cred/config\"}]}]},{\"group\":\"Smart Contract\",\"pages\":[{\"title\":\"Introduction\",\"description\":null,\"href\":\"/quest/smart-contract/introduction\"},{\"group\":\"Contracts\",\"pages\":[{\"title\":\"StarNFT\",\"description\":null,\"href\":\"/quest/smart-contract/contracts/starnft\"},{\"title\":\"SpaceStation\",\"description\":null,\"href\":\"/quest/smart-contract/contracts/spacestation\"}]},{\"title\":\"Smart Contract Audits\",\"sidebarTitle\":\"Audit Reports\",\"description\":null,\"href\":\"/quest/smart-contract/audit\"},{\"title\":\"Subgraph\",\"href\":\"/quest/smart-contract/subgraph\"}]}]},{\"tab\":\"Galxe Integration\",\"groups\":[{\"group\":\"Getting Started\",\"pages\":[{\"title\":\"Galxe Integration\",\"description\":\"Build powerful Web3 experiences with Galxe's comprehensive GraphQL API\",\"href\":\"/galxe-integration/introduction\"},{\"title\":\"Quick Start\",\"description\":\"Get your first API call working in under 3 minutes\",\"href\":\"/galxe-integration/getting-started/quick-start\"},{\"title\":\"Authentication\",\"description\":\"All Galxe API requests require a valid access token for authentication\",\"href\":\"/galxe-integration/getting-started/authentication\"},{\"title\":\"Common Integration Patterns\",\"description\":\"Reusable code patterns and GraphQL queries for efficient Galxe integration\",\"href\":\"/galxe-integration/getting-started/common-patterns\"}]},{\"group\":\"Integration Guides\",\"pages\":[{\"title\":\"Quest Integration\",\"description\":\"Build complete quest workflows with eligibility verification and status tracking\",\"href\":\"/galxe-integration/guides/quests\"},{\"title\":\"Loyalty Program Integration\",\"descr