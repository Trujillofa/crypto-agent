    <!-- Snippet: xu9a1_Y3j --><script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Legion?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Legion (legion.cc) is a MiCA-compliant crypto fundraising platform that operates as an ICO underwriter — not a launchpad. Legion handles token sale distribution, compliance, secondary trading, liquidity, and sell-side research. Backed by VanEck, Brevan Howard Digital, Kraken, and Coinbase Ventures."
      }
    },
    {
      "@type": "Question",
      "name": "How is Legion different from crypto launchpads like CoinList or Polkastarter?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Traditional launchpads host token sales. Legion underwrites them — providing distribution to 350,000+ verified investors plus Kraken's user base, MiCA-compliant regulatory framework, post-sale exchange listings, merit-based allocation via Legion Score, and two-way opt-in between projects and investors."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Legion Score?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Legion Score is a reputation-based rating from 0 to 1,000 that determines your allocation in token sales. It measures onchain activity, developer contributions, social presence, and long-term investment behavior. No platform token purchase is required."
      }
    },
    {
      "@type": "Question",
      "name": "Is Legion regulated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Legion is a licensed Crypto-Asset Service Provider (CASP) under the EU's MiCA framework. It also structures sales under Regulation S for non-US participants."
      }
    },
    {
      "@type": "Question",
      "name": "How do I participate in a token sale on Legion?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Create an account at legion.cc, complete KYC verification, and your Legion Score is calculated automatically. Browse upcoming token sales, express interest, and allocation is determined by your Legion Score."
      }
    }
  ]
}
</script><!-- SnippetEnd: xu9a1_Y3j --><!-- End of headEnd -->
