_next_f.push([1,"17:[\"$\",\"$L1a\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"affiliatesPage\":{\"earningsCalculator\":{\"average\":\"Average\",\"averageTooltip\":\"Projects average spend per referee and a typical share hitting the high-spender bonus.\",\"conservative\":\"Conservative\",\"conservativeTooltip\":\"Projects lower assumed spend per referee and fewer high-spender bonuses.\",\"explainAverage\":\"Explain Typical Spenders line\",\"explainConservative\":\"Explain Conservative Spenders line\",\"explainHigh\":\"Explain High Spenders line\",\"high\":\"High\",\"highTooltip\":\"Projects higher monthly spend per referee and more referees qualifying for the high-spender bonus.\",\"inRewards\":\"in rewards\",\"month\":\"Month {month}\",\"perMonthSuffix\":\"/month\",\"referralsLabel\":\"referrals\",\"tierBadge\":\"Affiliate Tier\",\"tierBadgeTooltip\":\"Affiliate tier at month 12 (based on qualifying referrals in the rolling 90-day window)\",\"timeline\":{\"today\":\"Today\",\"twelveMonths\":\"12 Months\"}},\"finalCta\":{\"title\":\"Become an affiliate today\"},\"hero\":{\"chart\":{\"estMonthly\":\"Est. monthly\",\"referrals\":\"Referrals\",\"referralsAriaLabel\":\"{count} referrals: estimated {amount} USD per month\"},\"subtitle\":\"Convert your influence into income. Become an ether.fi affiliate and earn when your referrals spend with ether.fi Cash.\",\"title\":\"Refer others, get paid.\"},\"howItWorks\":{\"steps\":{\"earn\":{\"body\":\"Get rewards as your referrals grow.\",\"title\":\"Earn\"},\"share\":{\"body\":\"Invite your audience using your personal referral link.\",\"title\":\"Share\"},\"spend\":{\"body\":\"Users activate and spend to qualify.\",\"title\":\"Spend\"}},\"title\":\"How to earn high commission\"},\"metadata\":{\"description\":\"Become an ether.fi affiliate and earn when your referrals spend with ether.fi Cash. Tiered commissions, bonuses, and real-time tracking.\",\"openGraph\":{\"description\":\"Convert your influence into income. Earn tiered rewards when your audience uses ether.fi Cash.\",\"title\":\"ether.fi Affiliate Program | Refer Others, Get Paid\"},\"title\":\"ether.fi Affiliate Program | Refer Others, Get Paid\",\"twitter\":{\"description\":\"Earn commissions when your referrals spend with ether.fi Cash. Join the affiliate program today.\",\"title\":\"ether.fi Affiliate Program\"}},\"rewards\":{\"aboutReferralThreshold\":\"About referral threshold\",\"disclaimer\":\"A qualifying referral is a user who signs up with your referral link, activates their ether.fi Cash card, and reaches ${minSpendUsd}+ in personal spending. Tier unlock requires both an all-time count and a rolling {windowDays}-day count of qualifying referrals (Tier 2: {tier2Min} / {tier2Window}, Tier 3: {tier3Min} / {tier3Window}, Tier 4: {tier4Min} / {tier4Window}, all-time / {windowDays}-day). Additional program rules may apply.\",\"referralThresholdTooltip\":\"Each tier needs both enough qualifying referrals all-time and enough in a rolling {windowDays}-day window (${minSpendUsd}+ personal spend on Cash per referral). Tier 2: {tier2Min} / {tier2Window}, Tier 3: {tier3Min} / {tier3Window}, Tier 4: {tier4Min} / {tier4Window} (all-time / {windowDays}-day).\",\"reward\":\"Reward\",\"rows\":{\"cardFeeCommission\":\"Card Fee Commission\",\"cashbackOnSpending\":\"Cashback on Referral Spending\",\"highSpenderBonus\":\"High Spender Bonus\",\"newMemberBonus\":\"New Member Bonus\",\"physicalCardCommission\":\"Physical Card Commission\",\"secondDegreeRevshare\":\"2nd Degree Revshare\",\"tierUnlock\":\"Tier Unlock\"},\"subtitle\":\"Earn cash rewards when your referrals spend with ether.fi Cash. Unlock higher tiers as you refer more users, giving you higher payouts.\",\"tier\":\"Tier {n}\",\"tierUnlockStarting\":\"Starting tier\",\"tierUnlockValue\":\"{count}+ all-time, {window}+ in {windowDays} days\",\"title\":\"Affiliate rewards\"},\"seeYourEarnings\":{\"disclaimer\":\"The numbers shown are estimates based on average referral performance and are not guaranteed. Actual results may vary.\",\"subtitle\":\"Use the slider to see how much you can earn as an affiliate.\",\"title\":\"Refer more, earn more.\"},\"whyBecomeAffiliate\":{\"benefits\":{\"lifetimeRewards\":{\"description\":\"No caps—earn for as long as your referrals keep spending with ether.fi Cash.\",\"title\":\"Lifetime rewards\"},\"realTimeData\":{\"description\":\"See earnings and referral activity in one dashboard, updated live.\",\"title\":\"Real-time data\"},\"tieredBonuses\":{\"description\":\"Refer more users and climb tiers for higher payouts as performance grows.\",\"title\":\"Tiered bonuses\"}},\"title\":\"Why become an ether.fi affiliate\"}},\"campaignPages\":{\"bestCryptoCard\":{\"staggerLine1\":\"The best crypto credit card.\"},\"cardThatPaysYou\":{\"staggerLine1\":\"The crypto card that pays you.\"},\"default\":{\"staggerLine2\":\"on your purchases\"},\"earnCryptoStagger\":\"Earn 3%-5% in crypto\",\"selfSovereignSpending\":{\"staggerLine1\":\"Self-Sovereign Spending\"}},\"careersPage\":{\"benefits\":{\"heading\":\"Why you will love working here\",\"impact\":{\"description\":\"The way people save, earn and spend their crypto is changing. We're a small company with big goals, and every employee helps us build crypto's future.\",\"title\":\"Impact\"},\"inOffice\":{\"description\":\"Our team thrives on the energy of working together in person. We believe face-to-face interactions foster stronger connections and drive our success.\",\"title\":\"In-office collaboration\"},\"offSiteRetreats\":{\"description\":\"From Cayman Islands to Lisbon, our frequent company retreats are where we bond, brainstorm, and build lasting memories.\",\"title\":\"Off-site retreats\"},\"topCompensation\":{\"description\":\"All employees are given annual performance-based bonuses, the option to be paid in ETH as well as a share of token allocation.\",\"title\":\"Top compensation\"},\"travelEvents\":{\"description\":\"We regularly attend top crypto events, staying at the forefront of innovation. These experiences fuel our passion and drive to revolutionize the industry.\",\"title\":\"Travel to cool events\"},\"wellnessBenefits\":{\"description\":\"All employees receive unlimited paid time off, one month per year to work fully remotely as well as health, dental and vision coverage.\",\"title\":\"Wellness benefits\"}},\"building\":{\"cash\":{\"description\":\"Spend and borrow against your crypto with this Visa credit card\",\"title\":\"Cash\"},\"heading\":\"What we're building\",\"liquid\":{\"description\":\"Automated strategy vaults that find yields for you\",\"title\":\"Liquid\"},\"stake\":{\"description\":\"Stake your ETH or stETH, get natively re-staked eETH\"}},\"community\":{\"discordButton\":\"Come Say Hello\",\"discordHeading\":\"Join the community\",\"linkedinButton\":\"Connect With Us\",\"linkedinHeading\":\"Connect on LinkedIn\"},\"company\":{\"decentralization\":{\"description\":\"We will never compromise on the non-custodial and decentralized nature of the protocol. Stakers must maintain control of their ETH.\",\"title\":\"Decentralization is a primary objective\"},\"ethics\":{\"description\":\"We will do the right thing for the Ethereum community, always. If and when we mess up we will admit to it and course correct, quickly.\",\"title\":\"Never compromise on ethics\"},\"heading\":\"We stand behind our guiding principles\",\"sustainableRevenue\":{\"description\":\"We're in this for the long haul, we think and plan on the scale of decades. No ponzinomics.\",\"title\":\"Sustainable revenue model\"}},\"hero\":{\"description\":\"At ether.fi, our mission is to put you in charge of your wealth. Save, grow and spend your crypto. Our team is in it for the long haul, dedicated to making crypto accessible and approachable, and to help people reach their goals through a full suite of products.\",\"title\":\"Careers at ether.fi\"},\"interview\":{\"heading\":\"Our interview process\",\"step1\":{\"line1\":\"Apply\",\"line2\":\"now\"},\"step2\":{\"line1\":\"Call with\",\"line2\":\"recruiter\"},\"step3\":{\"line1\":\"Meet the\",\"line2\":\"hiring manager\"},\"step4\":{\"line1\":\"Skills-based\",\"line2\":\"interview\"},\"step5\":{\"line1\":\"Interview with\",\"line2\":\"CEO\"}},\"locations\":{\"denverUsa\":\"Denver, USA\",\"dubaiUae\":\"Dubai, UAE\",\"grandCayman\":\"Grand Cayman\",\"heading\":\"Where we work\",\"newYorkUsa\":\"New York, USA\",\"torontoCanada\":\"Toronto, Canada\"},\"metadata\":{\"description\":\"We’re a mission-driven crypto company that helps you save, earn, and spend your crypto. With a product-first mindset and a hybrid on-site culture, we’re scaling fast — and hiring across product, engineering, marketing, people, customer success, and sales. Our global team is growing in Denver, Toronto, and the Cayman Islands. Come build the future with us\",\"openGraph\":{\"description\":\"We’re hiring! ether.fi is growing and looking for engineers, product leaders, and creatives who want to build the decentralized future of finance.\",\"title\":\"Build the Future of DeFi | Careers at ether.fi\"},\"title\":\"Careers at ether.fi | Help Build the Future of Decentralized Finance\",\"twitter\":{\"description\":\"We’re a mission-driven crypto company that helps you save, earn, and spend your crypto. With a product-first mindset and a hybrid on-site culture, we’re scaling fast — and hiring across product, engineering, marketing, people, customer success, and sales. Our global team is growing in Denver, Toronto, and the Cayman Islands. Come build the future with us\",\"title\":\"Join ether.fi | Build the Future of Decentralized Finance\"}},\"team\":{\"categories\":{\"businessDevelopment\":\"Business Development\",\"customerExperience\":\"Customer Experience\",\"engineering\":\"Engineering\",\"finance\":\"Finance\"},\"cities\":{\"cayman\":\"Cayman\",\"denver\":\"Denver\",\"dubai\":\"Dubai\",\"newYork\":\"New York\"},\"heading\":\"Join the team\"}},\"cashPage\":{\"appDownload\":{\"corporateCards\":{\"description\":\"Managing a crypto-native business? Issue credit cards to your team members. Cash back, non-custodial, and can use your treasury assets as collateral.\",\"title\":\"Corporate cards available\"},\"heading\":\"Get the app, pay with a tap.\",\"subtitle\":\"Use your card with Apple Pay and Google Pay.\"},\"cardComparison\":{\"cashbackAllLevels\":\"3% cashback on your purchases, all Cash card levels.\",\"comingSoonLegend\":\"(⏱️ = Features that are coming soon)\",\"features\":{\"airportLoungeAccess\":\"Airport Companion lounge access\",\"atmFee\":\"ATM 2% fee\",\"autoRentalInsurance\":\"Auto rental insurance\",\"baggageDelay\":\"Baggage Delay\",\"baggageDelayLimit\":\"Up to $500\",\"baggageLoss\":\"Baggage Loss\",\"baggageLossLimit\":\"Up to $1K\",\"cashback\":\"Cashback\",\"cashbackDisclaimer\":\"*Rates may differ on 0 FX fee EUR transactions.\",\"cashbackRate\":\"{rate}%\",\"concierge\":\"Concierge\",\"cryptoConcierge\":\"Crypto conceirge\",\"cryptoConferenceLounge\":\"Crypto conference lounge access\",\"details\":\"Details\",\"eventPasses\":\"Event passes\",\"eventPassesHint\":\"(crypto, sports and more)\",\"extendedWarranty\":\"Extended warranty\",\"familyMemberCards\":\"Family Member Cards w/ controls\",\"freePhysicalCards\":\"Free physical cards\",\"fxFee\":\"FX fee\",\"fxFeeValue\":\"0 FX fees on EUR, USD transactions. \u003clearnMore\u003eLearn more\u003c/learnMore\u003e\",\"membershipPointsRate\":\"Membership points rate\",\"membershipPointsValue\":\"3000 points for every $1000 spent (applies to all levels)\",\"nonCustodialAccount\":\"Non-custodial account\",\"physicalCardMetal\":\"Metal card included\",\"physicalCardPlastic\":\"Plastic\",\"priceProtection\":\"Price protection\",\"priceProtectionLimit\":\"Up to $2K\",\"prioritySupport\":\"Priority support\",\"prioritySupportHint\":\"(24/7 Live Chat and email)\",\"purchaseProtection\":\"Purchase protection\",\"referralRewards\":\"Referral rewards\",\"referralRewardsValue\":\"1% Cashback on referral purchases + 10% points on their deposits\",\"spendWithStables\":\"Spend with value-accruing stables\",\"spendingLimit\":\"Spending limit\",\"spendingLimitValue\":\"None\",\"venturesAccess\":\"ether.fi Ventures Access\",\"virtualCards\":\"Virtual cards\"},\"heading\":\"Cash is included when you join The Club for free\",\"joinTheClub\":\"Join the Club\",\"levels\":{\"core\":\"Core\",\"coreDescription\":\"All Club members\",\"luxe\":\"Luxe\",\"luxeDescription\":\"Level unlocked at 10K Membership Points\",\"pinnacle\":\"Pinnacle\",\"pinnacleDescription\":\"Level unlocked at 50K Membership Points\",\"vip\":\"VIP\",\"vipDescription\":\"Invite only\"},\"sections\":{\"cardholderBenefits\":\"Cardholder benefits\",\"feesAndLimits\":\"Fees \u0026 limits\",\"highlights\":\"Highlights\",\"purchaseProtection\":\"Purchase protection and insurance\"},\"seeAllBenefits\":\"See All Membership Benefits\"},\"getStarted\":{\"activateButton\":\"Activate Your Card\",\"activateHeading\":\"Let's activate your card.\",\"cardActivated\":\"Your card is now activated!\",\"clickActivate\":\"View your card details, then click \\\"Activate Physical Card\\\"\",\"enterActivationCode\":\"Enter activation code\",\"enterCodeDescription\":\"In the field displayed in the app, enter the activation code provided on your card.\",\"exploreApp\":\"Explore the app and start referring friends for extra cashback now.\",\"goToCashTab\":\"Go to the Cash tab in your account.\",\"viewCardDetails\":\"View your card details\",\"welcomeToCash\":\"Welcome to Cash\"},\"hero\":{\"staggerLine1\":\"Your DeFi-native\",\"staggerLine2\":\"credit card is finally here\",\"subtitle\":\"The non-custodial, cashback credit card you've been waiting for.\"},\"metadata\":{\"description\":\"Meet Cash — the crypto-powered credit card from ether.fi. Earn rewards, spend globally, and use your crypto. Now available for individuals, families, and businesses.\",\"openGraph\":{\"description\":\"Use your crypto without selling it. Cash by ether.fi is a credit card that gives you rewards, flexibility, and full control over your funds.\",\"title\":\"Spend \u0026 Earn Cashback with the DeFi-Native Credit Card | Cash by ether.fi\"},\"title\":\"The DeFi-Native Crypto Credit Card | Spend \u0026 Earn Cashback with Cash\",\"twitter\":{\"description\":\"Earn rewards, spend globally, and use your crypto — all with the Cash credit card from ether.fi. Personal, family, and corporate options available.\",\"title\":\"Your Crypto-Powered Credit Card is Here | Cash by ether.fi\"}},\"mobileCardComparison\":{\"annualFee\":\"Annual Fee\",\"atmWithdrawals\":\"ATM Withdrawals\",\"benefits\":\"Benefits\",\"fraudProtection\":\"Fraud Protection\",\"free\":\"Free\",\"freeUsdPayments\":\"Free USD payments\",\"fxFee\":\"FX Fee\",\"loadCryptoToAccount\":\"Load Crypto to Account\",\"monthlyFee\":\"Monthly fee\",\"spendingLimit\":\"Spending Limit\",\"virtualPhysicalCards\":\"Virtual \u0026 Physical Cards\"},\"overview\":{\"cardFlexibility\":{\"description\":\"Virtual and physical cards you can use for groceries, gas, hotels--whatever you need--across over 100 million locations.\",\"title\":\"Credit card flexibility\"},\"cashBack\":{\"description\":\"Earn cashback instantly, anywhere you spend with your card--automatically added to your account!\",\"title\":\"Cash Back on your purchases\"},\"exclusiveRewards\":{\"description\":\"Travel and DeFi rewards, conference passes and additional 1% cashback on every purchase made by your referrals.\",\"title\":\"Exclusive members-only rewards with Cash\"},\"heading\":\"Flexible, secure and rewarding.\",\"loadAccount\":{\"description\":\"Use your traditional bank accounts and exchanges to send and receive assets with your ether.fi Cash account.\",\"title\":\"Load your account from fiat or any non-custodial wallet\"},\"nonCustodial\":{\"description\":\"Stay in control with on-chain features. Your crypto remains in your control.\",\"title\":\"Non-custodial \u0026 secure\"},\"useYourCrypto\":{\"description\":\"Use your ether.fi crypto balance with Cash to spend with your card. Repay anytime, no monthly minimums.\"}},\"statsBanner\":{\"locationsWorldwide\":\"Over 100M locations worldwide\",\"useYourCrypto\":\"Use your crypto for real world spending\"}},\"common\":{\"actions\":{\"apply\":\"Apply\",\"becomeAMember\":\"Become a Member\",\"chatWithUs\":\"Chat With Us\",\"getStarted\":\"Get Started\",\"getTheCard\":\"Get the Card\",\"getYourCard\":\"Get Your Card\",\"howItWorks\":\"How It Works\",\"joinNow\":\"Join Now\",\"learnMore\":\"Learn More\",\"logIn\":\"Log In\",\"openApp\":\"Open App\",\"participateNow\":\"Participate Now\",\"share\":\"Share\",\"signUp\":\"Sign Up\",\"stakeNow\":\"Stake Now\",\"startEarning\":\"Start Earning\",\"viewOperators\":\"View Operators\"},\"countdown\":{\"days\":\"DAYS\",\"hours\":\"HRS\",\"minutes\":\"MINS\",\"seconds\":\"SECS\"},\"labels\":{\"appleGooglePay\":\"Apple Pay \u0026 Google Pay\",\"appleGooglePayReady\":\"Apple Pay and Google Pay ready\",\"audits\":\"Audits\",\"autoBalance\":\"Auto-balance\",\"bugBounty\":\"Bug Bounty\",\"campaignBanner\":\"Get ${value} to spend with Cash\",\"cashBackOnPurchases\":\"Cash back on your purchases\",\"cashCardDisclaimer\":\"ether.fi Cash card is not affiliated with the ether.fi protocol and issued subject to separate terms provided by Issuer.\",\"comingSoon\":\"(coming soon)\",\"compareLevels\":\"Compare Club membership levels\",\"conciergeServices\":\"Concierge services and more\",\"contactlessPayment\":\"Contactless payment\",\"copied\":\"Copied!\",\"cryptoEventTickets\":\"Crypto event tickets and lounge access\",\"decentralized\":\"Decentralized\",\"depositAssets\":\"Deposit assets\",\"earnRewards\":\"Earn rewards\",\"exclusiveHotelDiscounts\":\"Exclusive hotel discounts\",\"fillOutForm\":\"Fill out the form\",\"fixedRewards\":\"Fixed rewards\",\"getYourCardToday\":\"Get your card today.\",\"github\":\"GitHub\",\"globalTransfers\":\"Global transfers with IBAN/SWIFT integrations\",\"hassleFreeDeFi\":\"Hassle-free rewards across DeFi\",\"hotelDiscountValue\":\"Up to 65% off + 5% cashback\",\"investors\":\"Investors\",\"invitationOnly\":\"Invitation only\",\"lendingBorrowing\":\"Lending \u0026 borrowing\",\"leveragedFarming\":\"Leveraged farming\",\"limitedTimeOffer\":\"Limited-time offer.\",\"limitedTimeRestrictionsApply\":\"Limited time offer. Restrictions apply.\",\"loading\":\"Loading...\",\"luxuryHotelDiscounts\":\"Luxury hotel discounts of up to 65%\",\"openSourced\":\"Open sourced\",\"optionalCoverage\":\"Optional coverage available\",\"pageNotFound\":\"This page could not be found.\",\"sorry\":\"Sorry.\",\"stake\":\"Stake\",\"startEarningToday\":\"Start earning today\",\"startSavingToday\":\"Start saving today\",\"termsApply\":\"Terms apply\",\"trustedBy\":\"Trusted by\",\"unavailableInRegion\":\"ether.fi is unavailable in your region.\",\"upTo\":\"Up to\",\"upTo10K\":\"Up to $10K\",\"upToPerMonth\":\"up to {amount}/mo\",\"useEverywhereDefi\":\"Use everywhere across DeFi\",\"useYourCrypto\":\"Use your crypto\"}},\"corporateCardsPage\":{\"banner\":{\"contactUs\":\"Contact Us\",\"title\":\"Open your account today.\"},\"cashback\":{\"heading\":\"Give your employees cash back as a perk\",\"point1\":\"1% Cashback on your purchases\",\"point2\":\"Automatically deposited into their own account\",\"point3\":\"Give 100% to team members, 100% back to the company or split it 50/50\"},\"clubMembership\":{\"description\":\"Every member of your company is granted a personal account with a complimentary Membership to the ether.fi Club:\",\"heading\":\"Club membership access for everyone\"},\"hero\":{\"staggerLine1\":\" The credit card for your\",\"staggerLine2\":\"crypto-native business\",\"subtitle\":\"Cashback, non-custodial, and can use your treasury assets as collateral.\"},\"metadata\":{\"description\":\"Unlock the credit card designed for crypto-native businesses. Utilize your treasury assets, earn cash back on your purchases, and issue cards to your entire team — with built-in controls and reporting.\",\"openGraph\":{\"description\":\"Use your treasury’s crypto to power your cards — and reward your team while doing it. The ether.fi corporate credit card is built for security, flexibility, and performance.\",\"title\":\"Corporate Cards for Crypto-Native Businesses | ether.fi\"},\"title\":\"The Crypto Corporate Card for Web3 Teams\",\"twitter\":{\"description\":\"Issue cards, control spending, and earn cash back — all powered by crypto. ether.fi brings your business a secure, flexible DeFi-native credit card.\",\"title\":\"Corporate Cards for Crypto-Native Businesses | ether.fi\"}},\"overview\":{\"cashback\":{\"description\":\"Automatically give 100% cashback to employees as a perk. Set it to go to the company vault, or split it 50/50.\",\"title\":\"Cashback on your purchases\"},\"flexibleCardManagement\":{\"description\":\"Add as many cards as you need for your team, and start spending immediately with virtual cards. Flexible pricing plans and low accounts balance minimums, tailored to your business needs.\",\"title\":\"Flexible card management\"},\"heading\":\"Enterprise-level security and flexibility\",\"loadAccount\":{\"description\":\"Transfer funds from any fiat bank, exchange or crypto wallet to send and receive assets with your ether.fi account.\",\"title\":\"Load your account from fiat or any crypto wallet\"},\"secureCustomizable\":{\"description\":\"Grant your team members card-only access, to limit who manages your company account details. Your account is always in your control with customizable access through 2FA and multi-sig wallet options.\",\"title\":\"Secure, customizable and non-custodial\"},\"spendTracking\":{\"description\":\"View all card expenses at a glance, with detailed reporting exports, monitoring and customizable alerts.\",\"title\":\"Spend tracking \u0026 reporting\"},\"useYourCrypto\":{\"description\":\"Leverage your treasury's value-accruing assets in Borrow Mode and borrow against your crypto to spend with your card. Repay anytime, no monthly minimums.\"}},\"whiteGloveSupport\":{\"heading\":\"White glove support\",\"point1\":\"Dedicated account manager, with onboarding and setup guidance from Day 1\",\"point2\":\"24/7 Support for your team\",\"point3\":\"Tailored reporting \u0026 analytics available\"}},\"ethfiPage\":{\"benefits\":{\"heading\":\"Stake ETHFI for great benefits\",\"membershipLevels\":{\"description\":\"Stake ETHFI to unlock Club membership levels automatically.\",\"free\":\"Free\",\"title\":\"Increased membership levels\",\"unlockAt\":\"Unlock at {amount} ETHFI\"},\"monthlyRewards\":{\"description\":\"Exclusive to Club Members, stake ETHFI to access membership and receive regular token allocations when you use Stake, Liquid or cash products\",\"title\":\"Monthly rewards\"},\"subtitle\":\"The utility of ETHFI\",\"tokenBuybacks\":{\"description\":\"A portion of the protocol's monthly revenue is distributed to staked ETHFI (sETHFI) holders\",\"title\":\"Token buybacks\"}},\"community\":{\"daoDiscussion\":{\"btnText\":\"Join the Forum\",\"title\":\"DAO Discussion\"},\"discord\":{\"btnText\":\"Join Us\",\"title\":\"Discord\"},\"heading\":\"Join the community\",\"vote\":{\"btnText\":\"Vote on Proposals\",\"title\":\"Vote\"}},\"hero\":{\"heading\":\"Shape the future of ether.fi\",\"joinTheForum\":\"Join The Forum\",\"stakeEthfi\":\"Stake ETHFI\"},\"join\":{\"careersDescription\":\"The ether.fi Foundation is a world-spanning team of innovators. We're looking for talented individuals across governance, operations, finance, engineering, marketing and more. If you're interested in joining us, send us your resume.\",\"careersTitle\":\"ether.fi Foundation careers\",\"heading\":\"Join us in supporting the ether.fi protocol, empowering the next billion users through transparent, community-driven governance.\",\"joinFoundation\":\"Join the Foundation Team\"},\"overview\":{\"governance\":{\"ongoingGrowth\":{\"description\":\"Contribute to the growth and development of ether.fi\",\"title\":\"Ongoing growth\"},\"tokenUtility\":{\"description\":\"Influence token utility and design\",\"title\":\"Token utility\"},\"treasuryDecisions\":{\"description\":\"Input on decisions relating to ETHFI treasury\",\"title\":\"Treasury decisions\"}},\"heading\":\"Make key decisions on ether.fi's future\",\"holdersLabel\":\"ETHFI Holders\",\"tokenomics\":{\"coreContributors\":{\"description\":\"The people who continue to work tirelessly to bring the ether.fi protocol and community into existence. This allocation will be vested over a 3-year schedule.\",\"title\":\"Core Contributors\"},\"daoTreasury\":{\"description\":\"The Ecosystem Fund is a program meant to stimulate development in the ether.fi and greater Ethereum ecosystem by providing funding to projects and communities. 1% is committed to the Protocol Guild.\",\"title\":\"DAO Treasury\"},\"description\":\"The eligibility for the ETHFI token was determined by contribution to the ether.fi protocol, community and greater ecosystem over time.\",\"investors\":{\"description\":\"This allocation will be vested over a 2-year schedule.\"},\"partnerships\":{\"description\":\"These funds will be distributed strategically by the Foundation to ensure long-term growth in the ether.fi ecosystem.\",\"title\":\"Partnerships\"},\"title\":\"Tokenomics\",\"userAirdrops\":{\"description\":\"A series of airdrops to reward users for specific helpful behaviors, beginning with Airdrop Season 1 with 6% of the total ETHFI supply.\",\"title\":\"User Airdrops\"}}}},\"faq\":{\"affiliate\":{\"canCustomizeLink\":{\"p1\":\"Yes. Every affiliate receives a unique referral code, and you can set a **custom vanity tag** (e.g. ether.fi/@yourname) from the affiliate dashboard in the Cash app. This makes your link easier to share and remember across social media, newsletters, or content.\",\"title\":\"Can I customize my referral link?\"},\"howGetPaid\":{\"p1\":\"Affiliate rewards accrue in your ether.fi Cash account. Pending rewards are processed on a **monthly cycle** — once a processing month closes, rewards become eligible for payout after a short settlement period. You can track your pending balance and payout history in the affiliate dashboard.\",\"title\":\"How do I get paid?\"},\"howTiersWork\":{\"p1\":\"Your tier (1–4) determines your payout rates across all reward types — cashback on referral spending, new-member bonuses, high-spender bonuses, and 2nd-degree revshare. **Tier advancement is automatic** and calculated based on how many referrals you've made within a 90-day window. The more users you refer, the higher your tier and the larger your payouts.\",\"title\":\"How do tiers work?\"},\"whatIs2ndDegreeRevshare\":{\"p1\":\"Starting at Tier 2, you earn a percentage of the rewards generated by **your referrals’ referrals**. If someone you referred becomes an affiliate themselves and brings in new users, you receive 20% of their referral spending. This is in addition to your direct rewards and has no cap.\",\"title\":\"What is 2nd Degree Revshare?\"},\"whatQualifies\":{\"p1\":\"A referral qualifies when they **sign up** using your personal referral link, **activate** their ether.fi Cash card, and **spend $100+**. You start earning spend-based revshare once your referral makes their first purchase. New-member and high-spender bonuses are awarded as your referrals hit the relevant milestones.\",\"title\":\"What counts as a qualifying referral?\"},\"whoCanBecome\":{\"p1\":\"Every ether.fi user has affiliate status by default — all you need to do is signup and start sharing your referral link.\",\"title\":\"Who can become an ether.fi affiliate?\"}},\"institutional\":{\"canParticipateInDefi\":{\"p1\":\"Yes, eETH is designed to be used across various DeFi platforms, allowing institutions to earn additional yields while maintaining liquidity.\",\"title\":\"Can institutions participate in DeFi using eETH?\"},\"howGetStarted\":{\"p1\":\"Institutions interested in ether.fi's staking solutions can contact us to get started.\",\"title\":\"How can an institution get started with ether.fi?\"},\"howMinimizeCounterpartyRisk\":{\"p1\":\"ether.fi reduces counterparty risk by diversifying staking across top-tier node operators, allowing stakers to maintain custody of their withdrawal keys, and leveraging advanced insurance products.\",\"title\":\"How does ether.fi minimize counterparty risk?\"},\"whatCustodialOptions\":{\"p1\":\"For institutions preferring custodial solutions, ether.fi has partnered with Finoa, a qualified custodian, to securely store eETH.\",\"title\":\"What custodial options are available?\"},\"whatIsEthFund\":{\"p1\":\"The ETH Fund is a white-glove, end-to-end staking service tailored for institutional investors. It offers a controlled environment with annual audits, KYC compliance, and monthly statements, simplifying the staking process for institutions.\",\"title\":\"What is the ETH Fund, and how does it benefit institutions?\"},\"whatIsOffering\":{\"p1\":\"ether.fi provides tailored staking solutions for institutions, offering both non-custodial and custodial options. Institutions can stake ETH while retaining control over their assets or opt for a managed experience through ether.fi's ETH Fund, which is a CIMA-registered fund offering annual audits and monthly statements.\",\"title\":\"What is ether.fi's institutional staking offering?\"},\"whatRisks\":{\"li1\":\"**Non-custodial design**: Stakers retain control of their withdrawal keys.\",\"li2\":\"**Node operator diversification**: Stakes are spread across a trusted, high-performing set of operators to reduce exposure to slashing events.\",\"li3\":\"**Regular audits**: ether.fi's smart contracts are professionally audited to minimize exploit risk.\",\"li4\":\"**Optional coverage**: Users can opt into slashing and smart contract coverage via Nexus Mutual.\",\"p1\":\"Staking through ether.fi involves common risks like slashing, smart contract vulnerabilities, and counterparty risk. These are mitigated through:\",\"p2\":\"Together, these features help reduce the risk profile while maintaining high reward potential.\",\"title\":\"What risks are associated with staking through ether.fi?\"}},\"liquid\":{\"howGetStarted\":{\"p1\":\"To begin, visit the [ether.fi Liquid page](/app/liquid), connect your wallet, and choose the appropriate vault for your assets. The platform will handle the rest, optimizing your deposits across DeFi protocols.\",\"title\":\"How can I get started with ether.fi Liquid?\"},\"howOptimizeRewards\":{\"p1\":\"The Liquid vaults automatically distribute your deposited assets across a variety of DeFi positions, adjusting strategies and rebalancing as needed to remain competitive in the evolving DeFi market.\",\"title\":\"How does Liquid optimize rewards?\"},\"isCoverageAvailable\":{\"p1\":\"Yes, optional coverage is available through Nexus Mutual, providing an added layer of security for your assets in Liquid vaults.\",\"title\":\"Is there coverage available for Liquid vaults?\"},\"whatBenefits\":{\"p1\":\"By using Liquid vaults, you gain exposure to optimized DeFi strategies without the need to actively manage your positions. Additionally, you earn ether.fi Membership Points and other partner incentives.\",\"title\":\"What are the benefits of using Liquid vaults?\"},\"whatIsLiquid\":{\"p1\":\"ether.fi Liquid offers automated DeFi strategy vaults that allow users to deposit assets like eETH, ETH, or stablecoins. These vaults automatically allocate funds across various DeFi protocols to optimize rewards, eliminating the need for manual management.\",\"title\":\"What is ether.fi Liquid?\"},\"whichAssets\":{\"p1\":\"You can deposit eETH, ETH, USDC, and other supported assets into Liquid vaults. Each vault is designed to optimize returns based on the specific asset deposited.\",\"title\":\"Which assets can I deposit into Liquid vaults?\"}},\"membership\":{\"howCashbackWorks\":{\"p1\":\"1% cashback is earned instantly on purchases whenever someone on your team uses one of your corporate credit cards. You can use your card at over 100 million locations around the world. Your employees automatically receive this cashback on their own created personal accounts. You can change this at any time to 100% to your company Vault or split it with employees 50/50.\",\"title\":\"How does cashback work?\"},\"howOftenPayOff\":{\"p1\":\"You're in control. If you're spending from your stablecoin balance, there's nothing to pay back. If you're using Borrow Mode to use your Vault assets as collateral, you can repay anytime — no fixed due dates.\",\"title\":\"How often do I need to pay off my Vault balance?\"},\"howSignUp\":{\"p1\":\"Sign up for a Business account to get started. You will need to complete KYB for your business to activate the account. Once completed, you'll be able to immedialtely begin creating cards for your team!\",\"title\":\"How do I sign up for Corporate Cards?\"},\"whatExpenseManagement\":{\"p1\":\"Spend limits by Vault and card levels, multisig and role-based account management, export customizable transaction reporting and more.\",\"title\":\"What expense management features does ether.fi Corporate Cards have?\"},\"whatSpendLimit\":{\"p1\":\"Your spend amount limits level up with your business, from $50K-$250K per transaction and $250K-$1M per month. You can set your own customizable limits at the account and card limit level for increased flexibility. [See all fees and limits](https://help.ether.fi/en/articles/303623-what-are-the-transaction-limits-and-fees-for-personal-cash-credit-cards)\",\"title\":\"What is my spend limit?\"}},\"stake\":{\"howCanIGetWeeth\":{\"p1\":\"You can mint eETH, eBTC and eUSD by staking your ETH/BTC/stablecoins directly through the ether.fi app. Just connect your wallet, stake your assets, and receive weETH, eBTC or eUSD instantly. weETH also available on decentralized exchanges.\",\"title\":\"How can I get weETH?\"},\"howDoesEethEarnRewards\":{\"p1\":\"eETH earns rewards from both Ethereum staking and **restaking via EigenLayer, Symbiotic and Karak**. These rewards are automatically accrued and reflected in the value of your eETH over time.\",\"title\":\"How does eETH/weETH earn rewards?\"},\"whatFees\":{\"p1\":\"ether.fi charges a **10% fee on staking and restaking rewards**. This is shared between node operators, ether.fi contributors, and the broader ether.fi community. You keep the remaining **90% of all rewards**.\",\"title\":\"What fees are applied, and where do they go?\"},\"whatIsLiquidRestaking\":{\"p1\":\"Liquid restaking lets you stake ETH and earn additional rewards by securing not just Ethereum, but also other networks and services through **EigenLayer**. When you stake with ether.fi, you receive **eETH or wrapped eETH (weETH)**, liquid tokens that earn **staking and restaking rewards** — all while remaining non-custodial.\",\"title\":\"What is liquid restaking with ether.fi?\"},\"whatMakesDifferent\":{\"p1\":\"ether.fi is the **first and largest non-custodial liquid restaking protocol**. Stakers retain control of their ETH and keys while contributing to a more secure, decentralized future for Ethereum and emerging AVSs.\",\"title\":\"What makes ether.fi different?\"},\"whereCanIUseEeth\":{\"p1\":\"eETH, eBTC and eUSD are integrated across a growing number of DeFi platforms. You can use them as collateral, in LPs, or simply hold them to earn rewards — all while supporting decentralized infrastructure.\",\"title\":\"Where can I use eETH?\"}},\"title\":\"FAQs\"},\"footer\":{\"disclosure\":\"\u003cbold\u003eDisclosure\u003c/bold\u003e: ether.fi is a decentralized, non-custodial liquid restaking protocol. Participation in staking and restaking involves significant risks, including the potential loss of principal, slashing penalties, and smart contract vulnerabilities. Rewards are not guaranteed and are subject to network performance. This is not an offer to sell securities. Please read our full \u003ctermsLink\u003eTerms of Service\u003c/termsLink\u003e and \u003criskLink\u003eRisk Disclosures\u003c/riskLink\u003e before participating. Products may not be available in all jurisdictions.\",\"finePrints\":{\"rewardsTerms\":\"Subject to [Rewards Terms](https://etherfi.gitbook.io/etherfi/ether.fi-legal/ether.fi-cash-cashback-rewards-program-u.s.-and-international). Some promotions may increase the percentage of rewards earned. See cashback details [here](https://help.ether.fi/en/articles/262374-how-does-cashback-work)\"},\"legal\":{\"cookiePolicy\":\"Cookie Policy\",\"legal\":\"Legal\",\"privacyPolicy\":\"Privacy Policy\",\"termsOfUse\":\"Terms of Use\"},\"links\":{\"affiliateProgram\":\"Affiliate Program\",\"blog\":\"Blog\",\"bugBounty\":\"Bug Bounty\",\"careers\":\"Careers\",\"cash\":\"Cash\",\"corporateCards\":\"Corporate Cards\",\"defi\":\"DeFi\",\"defiLlama\":\"DeFi Llama\",\"docs\":\"Docs\",\"documentation\":\"Documentation\",\"dune\":\"Dune\",\"ethfi\":\"ETHFI\",\"forum\":\"Forum\",\"helpCenter\":\"Help Center\",\"institutionalStaking\":\"Institutional Staking\",\"liquid\":\"Liquid\",\"mediaKit\":\"Media Kit\",\"soloStaker\":\"Solo Staker\",\"stake\":\"Stake\",\"tokenTerminal\":\"Token Terminal\",\"voting\":\"Voting\"},\"sections\":{\"company\":\"Company\",\"governance\":\"Governance\",\"helpAndInfo\":\"Help \u0026 Info\",\"integrations\":\"Integrations\",\"organizations\":\"Organizations\",\"productsAndServices\":\"Products \u0026 Services\"}},\"homePage\":{\"articles\":{\"emailPlaceholder\":\"Enter your email address\",\"heading\":\"See the latest from ether.fi\",\"keepReading\":\"Keep reading\",\"signUp\":\"Sign Up\",\"subscribeFailed\":\"Failed to subscribe. Please try again.\",\"subscribeHeading\":\"Subscribe for the latest ether.fi updates and events\"},\"club\":{\"heading\":\"Membership rewards that go beyond the card\",\"intro\":\"Access rewards, global transfers, and premium financial services in one account.\",\"points\":{\"apy\":\"Earn 5%+ APY on your account balance\",\"borrowSpend\":\"Borrow to spend without selling your assets\",\"cashback\":\"Higher cashback with each tier\",\"globalTransfers\":\"Move money globally with bank transfers or crypto\",\"ibanAccess\":\"Hold USD or EUR with personal IBAN access\",\"travelPerks\":\"Travel, lounge, and concierge perks\"},\"signupForAccess\":\"Signup for Access\"},\"creditCard\":{\"cashbackOnAllPurchases\":\"cashback on all purchases\",\"description1\":\"The non-custodial cashback card that connects your ether.fi portfolio with everyday spending. Add funds with bank transfers or crypto. Spend at over 100 million locations worldwide. No credit checks.\",\"description2\":\"3% cashback. 0% FX fees on EUR and USD transactions.\",\"globalLocations\":\"Over 100 million locations worldwide\",\"heading\":\"A DeFi-native credit card, accepted worldwide\"},\"hero\":{\"mission\":\"Our mission is to put you in charge of your crypto\",\"tagline\":\"Save, grow, spend.\"},\"liquid\":{\"autoBalanceDescription\":\"Liquid vaults will deploy strategy assets to optimize for earnings and additional rewards across the very best protocols in DeFi.\",\"depositAssetsDescription\":\"Whether your goal is to maximize your earnings on ETH, BTC, stablecoins, or just to get exposure to the latest in DeFi, there’s a vault for you.\",\"earnRewardsDescription\":\"Earnings are auto-compounded in the vault for you. Withdraw or transfer to other vaults with ease when you’re looking to change strategies.\",\"heading\":\"Liquid puts your earnings on auto‑pilot\",\"seeLiquidVaults\":\"See Liquid Vaults\",\"subheading\":\"Automate your earnings with these strategy vaults\"},\"stakeSliders\":{\"heading\":\"Stake your assets to maximize rewards\",\"v1\":{\"descriptionLine1\":\"Staking allows you to keep exposure to ETH, BTC, or stablecoins while giving you additional earnings and rewards.\",\"descriptionLine2\":\"Secure, liquid and composable across DeFi.\",\"ebtcDescription\":\"Rewards with restaked BTC\",\"eusdDescription\":\"Value-accruing restaked stablecoins\",\"heading\":\"Put your assets to work with the leading restaking platform\",\"weethDescription\":\"Value-accruing restaked ETH\"},\"v2\":{\"description\":\"Enjoy rewards while keeping your assets secure, audited and monitored by industry-leading firms. Decentralized by design, ether.fi is built on top of Ethereum's robust decentralized infrastructure, ensuring trustworthiness and transparency.\",\"heading\":\"Secure \u0026 battle-tested\",\"protected\":\"Protected\"},\"v3\":{\"description\":\"With over 400 integrations across DeFi and centralized exchanges, with rewards when you trade, lend or leverage across the ecosystem.\",\"fixedYield\":\"Fixed yield\",\"go\":\"Go\",\"heading\":\"Use it everywhere\"}}},\"institutionalStaking\":{\"ecosystem\":{\"subtitle\":\"Over 400 integrations across DEX and CEX\"},\"ethFund\":{\"contactButton\":\"Contact Us About ETH Fund\",\"description\":\"Are you looking for exposure but don't know where to start? Our ETH Fund allows you to invest with fiat and we take care of the rest, including buying, selling, and investing the ETH to maximize rewards.\",\"title\":\"Receive white glove staking service through our ETH Fund\"},\"hero\":{\"description\":\"Tailored institutional non-custodial and custodial solutions that fit your needs.\",\"staggerLine1\":\"Flexible, secure, liquid staking\",\"staggerLine2\":\"rewards for institutions\"},\"infrastructure\":{\"description\":\"For institutional stakers and others who are interested in a managed staking service we're proud to partner with professional custodians who can help ether.fi members safely store their weETH.\",\"partnersTitle\":\"Infrastructure Partners\",\"title\":\"Available through industry leading custody solutions\"},\"metadata\":{\"description\":\"ether.fi offers institutions secure, scalable ETH staking with full transparency, custom custody integrations, and white-glove service via the ether.fi Fund. Built for compliance and yield optimization.\",\"openGraph\":{\"description\":\"Designed for institutions — ether.fi enables compliant, high-yield ETH staking with advanced custody and transparency solutions.\",\"title\":\"Secure, Liquid ETH Staking for Institutions | ether.fi\"},\"title\":\"Institutional Liquid Staking for ETH | Secure, Scalable \u0026 Transparent\",\"twitter\":{\"description\":\"Earn staking rewards with full control and compliance. ether.fi provides secure liquid staking and white-glove support for institutions.\",\"title\":\"Institutional ETH Staking with ether.fi\"}},\"overview\":{\"battleTestedDescription\":\"Earn smarter with your ETH, BTC, and stablecoins—securely and on-chain.\",\"battleTestedTitle\":\"Battle-tested \u0026 secure\",\"counterpartyRiskDescription\":\"Operational resilience via DVT and a distributed network of 20+ professional validators.\",\"counterpartyRiskTitle\":\"Minimized counterparty risk\",\"deepLiquidityDescription\":\"A liquid restaking asset designed for institutional scale and DeFi access\",\"deepLiquidityTitle\":\"Deep liquidity \u0026 rewards\",\"subtitle\":\"The leading value-accruing Liquid Restaking Token in DeFi.\",\"title\":\"Welcome to weETH\"},\"security\":{\"heading\":\"Enterprise‑level security. On‑chain transparency.\",\"openSourceDescription\":\"Transparent and peer-reviewed, with over 20,000 Node Operators across the globe.\",\"openSourceTitle\":\"Open sourced \u0026 decentralized\",\"protectedDescription\":\"Audited and monitored by industry-leading firms.\",\"protectedTitle\":\"Protected and frequently reviewed\"},\"tabs\":{\"ecosystem\":\"Ecosystem\",\"ethFund\":\"ETH Fund\",\"faq\":\"FAQ\",\"infrastructure\":\"Infrastructure\",\"overview\":\"Overview\",\"security\":\"Security\"}},\"liquidPage\":{\"ctaTitle\":\"Earn with Liquid.\",\"hero\":{\"ctaButton\":\"Check Out Liquid Vaults\",\"staggerLine1\":\"Liquid finds rewards\",\"staggerLine2\":\"so you don't have to\",\"subtitle\":\"Automate your earnings with ease with strategy vaults.\"},\"metadata\":{\"description\":\"Automate your crypto earnings with ether.fi’s Liquid Vaults. Earn high APYs on ETH, BTC, and stablecoins through diversified, optimized DeFi strategies — with full transparency and security.\",\"openGraph\":{\"description\":\"Earn high APYs on your crypto without the hassle. Liquid Vaults from ether.fi find the best DeFi rewards and optimize your assets automatically.\",\"title\":\"Automated Crypto Yields with Liquid Vaults | ether.fi\"},\"title\":\"Earn DeFi Rewards Effortlessly with Liquid Vaults\",\"twitter\":{\"description\":\"Liquid Vaults do the work for you — earn rewards on ETH, BTC, and stablecoins with automated DeFi strategies and full transparency.\",\"title\":\"Earn DeFi Yield Automatically with Liquid Vaults\"}},\"overview\":{\"autoBalanceDescription\":\"Liquid vaults will deploy strategy assets to optimize for earnings and additional rewards across the very best protocols in DeFi.\",\"depositAssetsDescription\":\"Whether your goal is to maximize your earnings on ETH, BTC, stablecoins, or just to get exposure to the latest in DeFi, there's a vault for you.\",\"earnRewardsDescription\":\"Earnings are auto-compounded in the vault for you. Withdraw or transfer to other vaults with ease when you're looking to change strategies.\"},\"security\":{\"heading\":\"Security-first vault architecture\",\"secureDescription1\":\"The protocol is designed with multiple safeguards in place, ranging from those encoded in the vault smart contracts to the validator set, which acts as a guardian between users and strategists. Smart contracts have been independently audited, and reviewed regularly through our active bug bounty program.\",\"secureDescription2\":\"Strategists can only move assets among the prescribed positions encoded in the vault smart contract.\",\"secureDescription3\":\"Users are the only ones with the ability to deposit or withdraw.\",\"secureTitle\":\"Secure\"},\"vault\":{\"apyDisclaimer\":\"APY is variable and not guaranteed. Some vaults may not be available in all regions.\",\"chooseVault\":\"Choose a vault\",\"deposit\":\"Deposit\",\"description\":\"Deposit assets and let the vault optimize for earnings across the very best protocols in DeFi.\",\"liquidBtcYield\":\"Liquid BTC Yield\",\"liquidEthYield\":\"Liquid ETH Yield\",\"liquidEur\":\"Liquid EUR\",\"liquidReserve\":\"Liquid Reserve\",\"liquidRwa\":\"Liquid RWA\",\"liquidUsd\":\"Liquid USD\",\"viewMoreVaults\":\"View More Vaults\"}},\"navbar\":{\"affiliates\":\"Affiliates\",\"business\":\"Business\",\"cash\":\"Cash\",\"corporateCards\":\"Corporate Cards\",\"homeAriaLabel\":\"Home\",\"institutionalStaking\":\"Institutional Staking\",\"liquid\":\"Liquid\",\"stake\":\"Stake\",\"theClub\":\"The Club\"},\"partnersPage\":{\"mexc\":{\"heroDescription\":\"Spend your crypto anywhere Visa is accepted with the exclusive {partnerName} card on ether.fi and receive a cashback boost on your spendings.\",\"heroTitle\":\"Get the {partnerName} Card Today\",\"staggerLine1\":\"Get the {partnerName} credit card and\",\"staggerLine2\":\"earn {cashbackRate}% cashback.\"}},\"promoPage\":{\"addFunds\":\"Add Funds\",\"addFundsDescription\":\"Earn daily ETHFI by depositing or minting \u003cbold\u003eliquid assets\u003c/bold\u003e into your Vault. \u003clink\u003eLearn more.\u003c/link\u003e\",\"earnShare\":\"Earn your share of 600,000 ETHFI\",\"howItWorks\":\"How it works\",\"metadata\":{\"description\":\"Add funds to your account, spend with your card, and earn your share of 600,000 ETHFI\",\"openGraph\":{\"description\":\"Add funds to your account, spend with your card, and earn your share of 600,000 ETHFI\",\"title\":\"Mint, Spend, Earn with ether.fi\"},\"title\":\"Mint, Spend, Earn with ether.fi\",\"twitter\":{\"description\":\"Add funds to your account, spend with your card, and earn your share of 600,000 ETHFI\",\"title\":\"Mint, Spend, Earn with ether.fi\"}},\"mintSpendEarn\":\"Mint, Spend, Earn\",\"promo\":\"PROMO\",\"signUpToParticipate\":\"Sign Up to Participate\",\"spendAndEarn\":\"Spend \u0026 Earn\",\"spendAndEarnDescription\":\"Earn ETHFI in addition to 3% cashback when you spend using your Cash card.\",\"the\":\"THE\"},\"referralLeaderboard\":{\"bannerMessages\":{\"addition\":\"Referral cashback is in addition to your normal cashback from card spends.\",\"cappuccino\":\"The average referrer earns enough cashback to buy a cappuccino per week!\",\"cars\":\"10 cars were bought with the Cash card. Referrers earning like a dealership.\",\"instant\":\"Did you know that cashback is sent as soon as your referrals spend?\",\"monetize\":\"Why not monetize your friends?\",\"tropical\":\"Top referrers have earned enough to fly to a tropical destination this summer.\",\"viral\":\"You are just one viral tweet away from financial independence, maybe.\"},\"joinTheClub\":\"Join The Club\",\"table\":{\"cashbackEarned\":\"Cashback earned\",\"member\":\"Member\",\"rank\":\"Rank\",\"referredMembers\":\"Referred members\"},\"title\":\"Leaderboard\"},\"rideAndDine\":{\"headline\":\"Get up to 15% cashback on rides and food\",\"secondaryText\":\"Earn up to 15% on rideshare, groceries and restaurants. 3% on other purchases.\",\"seeTerms\":\"See terms\",\"title\":\"Ride \u0026 Dine\"},\"siteMetadata\":{\"description\":\"ether.fi offers institutions secure, scalable ETH staking with full transparency, custom custody integrations, and white-glove service via the ether.fi Fund. Built for compliance and yield optimization.\",\"openGraph\":{\"description\":\"Put your crypto to work with ether.fi — earn rewards, access a credit card powered by DeFi, and get rewarded for holding assets like ETH, BTC, and stablecoins. No lockups, full control.\",\"title\":\"Stake, Earn, Spend. Do more with your crypto | ether.fi\"},\"titleDefault\":\"Save, Grow, Spend. Do more with your crypto | ether.fi\",\"twitter\":{\"description\":\"DeFi meets real-world spending. ether.fi lets you earn with ETH, BTC, and stablecoins while accessing a crypto Visa card — all non-custodial and fully yours.\",\"title\":\"Save, Grow, Spend. Do more with your crypto | ether.fi\"}},\"soloStakerPage\":{\"becomeASoloStaker\":\"Become a Solo Staker\",\"beginJourney\":{\"description\":\"If accepted, you will be emailed onboarding instructions. Additional documentation can be found on our Gitbook. Innovation is what we do and we want community members who are aligned. If you're interested in being part of our Raspberry Pi Solo Staking pilot program, click the box in the form below.\",\"heading\":\"Begin your journey.\"},\"choosePath\":{\"byoHardware\":{\"description\":\"Permissionless, with DVT for users that have staking hardware already to secure and validate the Ethereum network. For details on required staking hardware, see here.\",\"etherfiProvides\":\"Provides ETH, software and technical support.\",\"title\":\"BYO Hardware\",\"youProvide\":\"Provide the hardware and internet connection. No bond requirement needed.\"},\"etherfi\":\"ether.fi\",\"heading\":\"Choose your path\",\"providedHardware\":{\"description\":\"Commit to operate a node for 2 years, and we'll structure a 2 year payment plan for you to own the provided machine from the rewards you've generated staking ETH.\",\"etherfiProvides\":\"Provides ETH, hardware, software and technical support.\",\"title\":\"ether.fi-Provided Hardware\",\"youProvide\":\"Provide internet connection and enter into a payment agreement over a 2-yr period.\"},\"readMore\":\"Read More\",\"registeredSuppliers\":\"Registered suppliers can be found\",\"registeredSuppliersLink\":\"here\",\"you\":\"You\"},\"criteria\":{\"agreeToTerms\":{\"description\":\"Must be willing to sign agreement of program terms.\",\"title\":\"Agree to terms\"},\"bandwidth\":{\"description\":\"Must have a solid internet connection with at least 250/100 bandwidth with no cap\",\"title\":\"Bandwidth\"},\"doxxed\":{\"description\":\"Must be comfortable being doxxed to ether.fi\",\"title\":\"Doxxed\"},\"experience\":{\"description\":\"Must have experience staking and be technically competent.\",\"title\":\"Experience\"},\"heading\":\"Solo staker criteria\",\"subtitle\":\"These criteria will be relaxed as the program scales.\"},\"hero\":{\"inPartnershipWith\":\"In partnership with\",\"staggerLine\":\"Operation Solo Staker\",\"subtitle\":\"Enabling anyone to run nodes, further decentralizing the Ethereum network.\"},\"metadata\":{\"description\":\"Join Operation Solo Staker and help decentralize Ethereum. Run your own node using ether.fi’s validator distribution, no ETH deposit required. Use your own hardware or get it provided.\",\"openGraph\":{\"description\":\"No ETH required. Just bring your own hardware or get it from us. Join ether.fi’s Operation Solo Staker and help decentralize Ethereum.\",\"title\":\"Run a Solo ETH Node | Operation Solo Staker by ether.fi\"},\"title\":\"Become a Solo ETH Node Operator | Operation Solo Staker\",\"twitter\":{\"description\":\"Help power the Ethereum network. Run your own validator with no ETH deposit using DVT tech and support from ether.fi.\",\"title\":\"Become a Solo Staker | Decentralize Ethereum with ether.fi\"}},\"whySoloStaker\":{\"decentralization\":{\"description\":\"Distributes validator keys to diverse operators using DVT, reducing risks and promoting decentralization.\",\"title\":\"Decentralization\"},\"earnRewards\":{\"description\":\"Participants earn rewards by supporting and validating the Ethereum network, benefiting stakers and the Ethereum ecosystem.\"},\"noEthDeposit\":{\"description\":\"With the implementation of Distributed Validator Technology (DVT), the need for an ETH bond is completely eliminated.\",\"title\":\"No ETH deposit\"}}},\"stakePage\":{\"assets\":{\"chooseAsset\":\"Choose your asset\",\"description\":\"ether.fi assets are redeemable for your underlying staked ETH, BTC, or stablecoins.\",\"disclaimer\":\"Redemption values may vary based on market conditions, protocol liquidity, and smart contract performance. APY is variable and not guaranteed.\",\"valueAccruing\":\"Value-accruing restaked {coinName}\"},\"hero\":{\"staggerLine\":\"Stake your assets and get rewards\",\"subtitle\":\"Value-accruing assets for greater rewards on your crypto.\"},\"metadata\":{\"description\":\"Maximize your crypto earnings with ether.fi. Stake ETH, BTC, and stablecoins to earn greater rewards, maintain custody, and unlock rewards across the DeFi ecosystem.\",\"openGraph\":{\"description\":\"Stake your crypto and earn more rewards with ether.fi. No lockups, non-custodial, and DeFi-integrated across major ecosystems.\",\"title\":\"Stake your assets and get rewards | ether.fi\"},\"title\":\"Stake your assets and get rewards\",\"twitter\":{\"description\":\"Stake ETH, BTC, and stablecoins with ether.fi to earn rewards while keeping full control. Integrated with DeFi and built for greater rewards.\",\"title\":\"Stake Crypto and Earn More with ether.fi\"}},\"restaking\":{\"curiosity\":\"Curious about how staking and re-staking works?\",\"earnRewardsDescription\":\"Receive value-accruing weETH, eBTC or eUSD. Integrated across 400+ DeFi protocols.\",\"readAboutRestaking\":\"Read About Restaking\",\"restakingDescription\":\"Your assets are restaked, securing and supporting the Ethereum ecosystem.\",\"stakeAssets\":\"Stake assets\",\"stakeAssetsDescription\":\"Earn more on your ETH, BTC, stablecoins. Secure and non-custodial.\"},\"security\":{\"chaosRiskMonitoring\":\"Chaos risk monitoring\",\"description\":\"Enjoy rewards while keeping your assets secure, audited and monitored by industry-leading firms. Decentralized by design, ether.fi is built on top of Ethereum's robust decentralized infrastructure, ensuring trustworthiness and transparency.\",\"heading\":\"Battle-tested and secure\",\"infrastructurePartners\":\"Infrastructure \u0026 custody partners\",\"protectedByExperts\":\"Protected by industry experts\"},\"usage\":{\"collateral\":\"Collateral\",\"liquidAutomatedVaults\":\"Liquid automated vaults\",\"subtitle\":\"Over 400 integrations across DEX, CEX and OTC\",\"trade\":\"Trade\"}},\"statsBanner\":{\"activeWallets\":\"Active Wallets\",\"cashBackOnPurchases\":\"1% cash back on your purchases\",\"creditCardCashback\":\"Credit Card Cashback\",\"defiIntegrations\":\"DeFi Integrations\",\"liquidRewards\":\"Liquid Rewards\",\"stakeRewards\":\"Stake Rewards\",\"tvl\":\"TVL\",\"useCryptoAsCollateral\":\"Use your crypto as collateral\",\"usedAsCollateral\":\"Used as Collateral\",\"virtualMetalCards\":\"Virtual \u0026 metal cards for your team\"},\"testimonials\":{\"affiliate\":{\"cbb0fe\":\"The ether.fi card is by far my best experience in crypto banking.\",\"dotAriaLabel\":\"Testimonial {current} of {total}\",\"galleryCardAlt\":\"ether.fi Cash gold card held up in front of contemporary gallery artwork\",\"heading\":\"People's choice everywhere\",\"johnnyTime\":\"I sleep well at night while parking cash on Etherfi vaults.\",\"nicoypei\":\"Beyond bullish on the ether.fi Card!\",\"overtureCardAlt\":\"ether.fi Cash gold card in a leather wallet beside an Overture aircraft model\",\"parisCardAlt\":\"ether.fi Cash card held in front of the Arc de Triomphe\",\"rektonomist\":\"I've been using ether.fi Pinnacle! Been loving it, especially towards buying watches, houses and some other high value assets.\",\"vipCardAlt\":\"ether.fi Cash gold VIP card unboxed in a \\\"Welcome to VIP\\\" presentation box\"},\"institutional\":{\"defiDad\":\"ether.fi represents the truest vision that sold us all on DeFi—to democratize access to the best yields onchain, especially with restaked ETH able to support the health of the Ethereum network while earning a competitive yield. There's a reason they are such a leader in this market, attracting more liquidity from the biggest allocators onchain who demand the best security.\",\"jordiSelini\":\"The Etherfi team have been lazer focused on building useful and sustainable primitives from day1, establishing a reputation for reliability and competence\",\"lukeLiAmber\":\"At Amber, capital efficiency, liquidity, and risk management are paramount. Ether.fi stands out by offering not just competitive yield, but a truly institutional-grade product experience. From eETH's seamless composability across DeFi to the underlying security design, ether.fi helps us access meaningful DeFi native yield opportunities while maintaining the control and flexibility we need.\",\"michaelArrington\":\"EtherFi has redefined institutional-grade staking by offering hedge funds a unique combination of uncompromising asset control, risk adjusted returns, and the trust that comes with a lengthy list of top tier infrastructure partners. With over $4B in TVL, EtherFI is a fortified system where institutions can deploy capital with confidence and institutional-caliber safeguards.\",\"stephenDefiDojo\":\"weETH has been the most consistent ETH yield asset for the past nearly two years now. Hoping eBTC does the same for Bitcoin.\",\"tnPendle\":\"Working with EtherFi has been an absolute pleasure. We deeply appreciate the strong relationship we've built with their team, who stand out as one of the most competent and capable groups we've ever had the privilege of collaborating with.\",\"vadimEdgeCapital\":\"Edge Capital has been re-staking ETH with Ether.fi since early 2024.  Ether.fi makes Ethereum staking simple, secure, and truly decentralized. I trust their non-custodial approach and transparent platform, giving our investors confidence while earning reliable rewards\"}},\"theClubPage\":{\"cta\":{\"ctaButton\":\"Let's Go\",\"heading\":\"Join the club\"},\"defiRewards\":{\"defiPartnerExclusives\":\"DeFi partner exclusives\",\"heading\":\"DeFi and IRL rewards like no other\",\"luxuryHotelBookings\":\"Luxury hotel bookings and exceptional discounts of up to 65%\"},\"hero\":{\"cashbackOnCard\":\"Cashback on all card purchases\",\"cryptoLoungesEvents\":\"Priority support, crypto lounges, concierge and more\",\"heading\":\"Join the Club.\",\"portfolioTrackingRewards\":\"Portfolio tracking \u0026 reward boosts\",\"subtitle\":\"Great rewards and personal finance services, exclusive to Club members.\"},\"memberTable\":{\"allClubMembers\":\"All Club members\",\"cardStyle\":\"Card Style\",\"cashDeFiCreditCard\":\"Cash: The DeFi-native credit card\",\"cashbackAllLevels\":\"3% cashback. 0% FX fees on EUR and USD transactions.\",\"cashbackOnPurchases\":\"Cashback on all purchases\",\"clubMemberBenefits\":\"Club member benefits\",\"concierge\":\"Concierge\",\"eventPasses\":\"Event passes\",\"eventPassesHint\":\"(crypto, sports and more)\",\"fiatCryptoTransfers\":\"Fiat\u003c\u003eCrypto transfers\",\"globalWireTransfers\":\"Global Wire transfers\",\"heading\":\"Become a member today\",\"joinTheClub\":\"Join the Club\",\"levelUnlockedAt10K\":\"Level unlocked at 10K Loyalty Points\",\"levelUnlockedAt50K\":\"Level unlocked at 50K Loyalty Points\",\"liquidAutomatedVaults\":\"Liquid: Automated strategy vaults\",\"membershipPointsRate\":\"Loyalty points rate\",\"monthlyLimitWithFee\":\"{limit}/mo limit {fee} fee\",\"onChainPortfolioManagement\":\"On-chain portfolio management\",\"personalFinanceServices\":\"Personal finance services\",\"pointsPerDayLiquid\":\"9 points/day for every $1,000 staked (applies to all levels)\",\"pointsPerDayStake\":\"3 points/day for every $1,000 staked (applies to all levels)\",\"pointsPerSpend\":\"3,000 points for every $1,000 spent (applies to all levels)\",\"prioritySupport\":\"Priority support\",\"prioritySupportHint\":\"(24/7 Live Chat and email)\",\"referralRewards\":\"Referral rewards\",\"referralRewardsValue\":\"1% cashback on referral purchases + 10% points on their deposits\",\"seeAllCardDetails\":\"See all card details\",\"stakeValueAccruing\":\"Stake: Value-accruing assets\",\"subtitle\":\"Earn the most exclusive rewards in DeFi, plus membership points that you can use towards your ether.fi experience.\",\"taxReporting\":\"Tax reporting\",\"venturesAccess\":\"Ventures Access\"},\"metadata\":{\"description\":\"The Club by ether.fi offers members exclusive reward boosts, VIP benefits, and real-world perks. Use crypto, earn rewards, and access premium personal finance services by becoming a member\",\"openGraph\":{\"description\":\"Access exclusive rewards, earning boosts, and member-only perks. Become part of ether.fi's premium membership experience today.\",\"title\":\"Join The Club | ether.fi Membership Rewards\"},\"title\":\"Join The Club | Unlock Exclusive Rewards with ether.fi Membership\",\"twitter\":{\"description\":\"The Club by ether.fi offers tiered benefits, cashback, and DeFi reward perks. Join today and earn more with your crypto.\",\"title\":\"Exclusive Rewards with The Club | Join ether.fi Membership\"}},\"monthlyRewards\":{\"earnMembershipPoints\":\"Earn membership points to level up your membership for more rewards when you use in Stake, Liquid and Cash\",\"heading\":\"Seasonal reward boosts, exclusive to members\",\"membersEarnBoosts\":\"Members earn exclusive seasonal reward boosts\"},\"payWithCrypto\":{\"heading\":\"Use your crypto, spend anywhere you go.\",\"learnAboutCash\":\"Learn About Cash\",\"moveFunds\":\"Move funds to and from crypto wallets or traditional banking using IBAN and SWIFT\",\"nonCustodialSecure\":\"Non-custodial and secure\",\"upTo3Cashback\":\"Up to 3% cashback on your purchases\",\"useYourCrypto\":\"Use your crypto to power your card\"},\"yourAlternative\":{\"borrowToSpend\":\"Borrow against your assets to spend without selling\",\"earnOnAssets\":\"Earn 5%+ on your account assets\",\"heading\":\"Your alternative to traditional banking.\",\"holdUsdEur\":\"Hold USD and EUR in your account\",\"onChainPortfolio\":\"On-chain portfolio management and tax reporting\",\"privateAccountManagement\":\"Private account management \u0026 concierge services\",\"transferGlobalCurrencies\":\"Transfer BRL, AED, and more currencies worldwide\"}},\"unchainedPage\":{\"m