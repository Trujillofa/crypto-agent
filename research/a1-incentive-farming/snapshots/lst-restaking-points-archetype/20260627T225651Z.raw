t>self.__next_f.push([1,"U5ZxfH85YxHLp6UiXK8\",\"/_next/static/chunks/13swj.5os7-gf.js?dpl=dpl_7Ti7LWJ6KU5ZxfH85YxHLp6UiXK8\",\"/_next/static/chunks/078pd29ewae4i.js?dpl=dpl_7Ti7LWJ6KU5ZxfH85YxHLp6UiXK8\",\"/_next/static/chunks/11oz3dehe._o..js?dpl=dpl_7Ti7LWJ6KU5ZxfH85YxHLp6UiXK8\",\"/_next/static/chunks/0e67ejkb9jly~.js?dpl=dpl_7Ti7LWJ6KU5ZxfH85YxHLp6UiXK8\",\"/_next/static/chunks/0xj0jajrbbnku.js?dpl=dpl_7Ti7LWJ6KU5ZxfH85YxHLp6UiXK8\",\"/_next/static/chunks/0-0c76g3hh_nr.js?dpl=dpl_7Ti7LWJ6KU5ZxfH85YxHLp6UiXK8\",\"/_next/static/chunks/0n4n9s14f.hjp.js?dpl=dpl_7Ti7LWJ6KU5ZxfH85YxHLp6UiXK8\",\"/_next/static/chunks/0x48_yb8~~fds.js?dpl=dpl_7Ti7LWJ6KU5ZxfH85YxHLp6UiXK8\"],\"Link\"]\n"])</script><script>self.__next_f.push([1,"b:[[\"$\",\"$L1e\",null,{\"metricData\":{\"tvl\":2755870538.9918222,\"stakeApr\":2.4872351968948903,\"liquidApy\":7.190375467646478,\"cashBack\":3},\"latestArticles\":[{\"title\":\"Non-custodial, actively defended: how ether.fi thinks about security\",\"description\":\"When an exploit hits a DeFi protocol, the window to prevent loss is measured in seconds. ether.fi is built, end to end, to use them. How non-custodial design and active defense work together across four layers.\",\"imageUrl\":\"https://cdn.sanity.io/images/ufyao9jy/production/9a0691674c25e1b06db1bea5870fac9745ca7b1f-1360x768.jpg?rect=104,0,1152,768\u0026w=1170\u0026h=780\u0026auto=format\u0026rev=2026-06-24T14%3A56%3A49Z\",\"imageAlt\":\"Image Banner\",\"url\":\"/blog/non-custodial-actively-defended\"},{\"title\":\"How ether.fi Redeemed 20% of TVL Without Adding a Day to Ethereum's Exit Queue\",\"description\":\"In 33 days, ether.fi redeemed 542,792 ETH, 19.6% of its TVL, during a market-wide rush for the exits. It did so without lengthening Ethereum's shared exit queue for anyone else. Here's how.\",\"imageUrl\":\"https://cdn.sanity.io/images/ufyao9jy/production/a451753ca4a95a24c3f2595852707ce534232977-1360x768.jpg?rect=104,0,1152,768\u0026w=1170\u0026h=780\u0026auto=format\u0026r