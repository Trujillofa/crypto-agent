[Unit]
Description=Crypto-agent automated NFP consensus capture and alert
After=network-online.target
Wants=network-online.target
OnFailure=crypto-agent-telegram-failure@%n.service

[Service]
Type=oneshot
User=emilio
WorkingDirectory=/opt/crypto-agent
EnvironmentFile=/opt/crypto-agent/.env
ExecStart=/usr/bin/python3 scripts/nfp_forward_capture.py cron

[Install]
WantedBy=multi-user.target
