[Unit]
Description=Crypto-agent automated NFP consensus capture and alert
After=network-online.target
Wants=network-online.target
OnFailure=crypto-agent-telegram-failure@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/crypto-agent
# Scoped env: only the Telegram alert vars, not the full .env (audit L3).
# Create with: grep -E '^(TELEGRAM_ENABLED|TELEGRAM_BOT_TOKEN|TELEGRAM_CHAT_ID)=' \
#   /opt/crypto-agent/.env > /etc/crypto-agent/nfp-capture.env && chmod 600
EnvironmentFile=/etc/crypto-agent/nfp-capture.env
# The capture script needs httpx; the system python lacks project deps, so run
# it through the uv-managed project env. uv must be installed at the absolute
# path below (no login-shell PATH games in a systemd unit):
#   curl -LsSf https://astral.sh/uv/install.sh | sh
Environment=NFP_PENDING_CAPTURE_PATH=/var/lib/crypto-agent/nfp_forward/pending_capture.json
ExecStart=/root/.local/bin/uv run --project /opt/crypto-agent python scripts/nfp_forward_capture.py cron

[Install]
WantedBy=multi-user.target
