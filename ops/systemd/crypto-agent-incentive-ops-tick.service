[Unit]
Description=Daily read-only tick for crypto-agent A1 incentive-ops Phase-0 baseline
OnFailure=crypto-agent-telegram-failure@%n.service

[Service]
Type=oneshot
User=emilio
WorkingDirectory=/opt/crypto-agent
EnvironmentFile=-/etc/default/crypto-agent-incentive-ops-tick
ExecStart=/bin/bash scripts/incentive_ops_daily_tick.sh

[Install]
WantedBy=multi-user.target
