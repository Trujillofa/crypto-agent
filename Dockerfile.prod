# Production Dockerfile for crypto-agent
# Multi-stage build for smaller image size

# Stage 1: Build dependencies
FROM python:3.11-slim as builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt


# Stage 2: Production image
FROM python:3.11-slim as production

# Create non-root user for security
RUN groupadd -r crypto && useradd -r -g crypto crypto

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY --chown=crypto:crypto src/ ./src/
COPY --chown=crypto:crypto config/ ./config/
COPY --chown=crypto:crypto migrations/ ./migrations/
COPY --chown=crypto:crypto scripts/ ./scripts/

# Create data directory
RUN mkdir -p /app/data && chown crypto:crypto /app/data

# Switch to non-root user
USER crypto

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Expose metrics port
EXPOSE 8000

# Run the application
CMD ["python", "-m", "src.main"]
