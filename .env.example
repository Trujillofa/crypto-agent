BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=marketdata
POSTGRES_USER=trading
POSTGRES_PASSWORD=

PROMETHEUS_PORT=8000
GRAFANA_ADMIN_PASSWORD=

# Telegram notifications (optional)
# Get bot token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
TELEGRAM_RATE_LIMIT=5

# AI overseer (optional)
XAI_API_KEY=
# Optional paid xAI fallback after free providers. Explicit opt-in only.
XAI_FALLBACK_ENABLED=false
# Optional fallback provider for xAI outages/capacity events
DEEPSEEK_API_KEY=
# Z.AI (GLM) OpenAI-compat provider — primary for sentiment-macro when
# ai.provider: zai. Coding Plan subscription keys must use
# https://api.z.ai/api/coding/paas/v4 (pay-as-you-go keys use
# https://api.z.ai/api/paas/v4, the default)
ZAI_API_KEY=
OPENCODE_GO_ENABLED=false
OPENCODE_GO_API_KEY=
# Command Code is optional, paid and off by default. Do not put its key in this
# shared file. See docs/commandcode-sentiment.md for the sentiment-only overlay.
# NVIDIA NIM hosted API (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash
# Ollama Cloud direct API (OpenAI-compatible; local Ollama does not use an API key)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b
